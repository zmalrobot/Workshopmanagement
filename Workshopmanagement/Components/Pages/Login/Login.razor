@page "/login"
@* @rendermode InteractiveServer *@

@inject IJSRuntime JSRuntime
@inject IDbDependency dbDependency
@inject ISnackbar snackbar
@inject ILanguageContainerService languageContainer
@inject ProtectedLocalStorage protectedLocalStorage
@inject NavigationManager navigationManager
@inject IWebHostEnvironment webHostEnvironment

<PageTitle>@languageContainer.Keys["ApplicationName"]</PageTitle>

<MudCard Class="pa-4 mx-auto" Style="max-width: 400px;">
    <MudCardHeader>    
        <MudGrid>
            <MudItem xs="12" Style="text-align: center;">
                @if (companySettings?.HasLogo == true)
                {
                    <img src="/images/companylogo.png" alt="Logo" style="width:100px; height:100px; object-fit:cover; border-radius:50%;" />
                }
                else
                {
                    <MudImage Alt="Missing logo.png" Src="../logo.png" Height="100" />
                }
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.h4" Style="text-align: center;">
                    @languageContainer.Keys["LoginTitle"]
                </MudText>
                @if (!string.IsNullOrWhiteSpace(companySettings?.CompanyName))
                {
                    <MudText Typo="Typo.subtitle1" Align="Align.Center" Color="Color.Secondary">
                        @companySettings.CompanyName
                    </MudText>
                }
            </MudItem>
        </MudGrid>

    </MudCardHeader>
    <MudCardContent>
        @if (isFirstUser)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">@languageContainer.Keys["LoginNoUsersWarning"]</MudAlert>
        }
        <MudTextField @bind-Value="userModel.Username" Label="@languageContainer.Keys["Username"]" Variant="Variant.Filled" Required="true" />
        <MudTextField @bind-Value="userModel.Password" Label="@languageContainer.Keys["Password"]" Variant="Variant.Filled" InputType="InputType.Password" Required="true" />
    </MudCardContent>
    <MudCardActions>
        <MudGrid>
            <MudItem xs="12" Style="text-align: right;">
                <MudButton Disabled="@processing" OnClick="@(() => HandleLogin())" Variant="Variant.Filled" Color="Color.Primary">
                    @if (processing)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">
                            @languageContainer.Keys["Login"]
                        </MudText>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Login" Size="Size.Small" Style="margin-right: 15px;"></MudIcon>
                        <MudText>
                            @languageContainer.Keys["Login"]
                        </MudText>
                    }
                </MudButton>
            </MudItem>         
        </MudGrid>        
    </MudCardActions>
</MudCard>
@code {
    // Model for the login form
    private UserModel userModel = new UserModel()
    {
        // Username = "zmalqp", //TEST ONLY
        // Password = "zmalqop"
    };
    private bool processing = false;
    private bool reloading = false;
    private bool isFirstUser = false;
    private CompanySettings? companySettings;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var allEmployees = await dbDependency.GetDataAccessEmployee().FindAsync(new SearcherEmployee());
            isFirstUser = allEmployees == null || allEmployees.Count == 0;

            var settingsList = await dbDependency.GetDataAccessCompanySettings().FindAsync(new SearcherCompanySettings());
            companySettings = settingsList?.FirstOrDefault();
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {        
        var refresh = reloading || processing;
        if (processing)
            processing = false;
        if (reloading)
            reloading = false;

        if (refresh)
            StateHasChanged();
    }

    // Handling the login
    private async Task HandleLogin()
    {
        processing = true;
        try
        {
            if (String.IsNullOrEmpty(userModel.Username?.Trim()) || String.IsNullOrEmpty(userModel.Password?.Trim()))
            {
                snackbar.Add(@languageContainer.Keys["LoginIsNotValid"], Severity.Warning);
            }
            else
            {
                var dataAccessEmployee = dbDependency.GetDataAccessEmployee();

                // If no employees exist, create the first user as Manager
                var allEmployees = await dataAccessEmployee.FindAsync(new SearcherEmployee());
                if (allEmployees == null || allEmployees.Count == 0)
                {
                    var newManager = new Employee
                    {
                        Id = Guid.NewGuid().ToString(),
                        Username = userModel.Username.Trim(),
                        Password = Cypher.Encrypt(userModel.Password),
                        Name = userModel.Username.Trim(),
                        Surname = string.Empty,
                        EmployeeRole = EmployeeRole.Manager,
                        InsertDate = DateTime.Now,
                        UpdateDate = DateTime.Now,
                        IsActive = true
                    };
                    await dataAccessEmployee.InsertAsync(newManager);

                    await Utility.SaveCurrentLoggedEmployee(protectedLocalStorage, newManager);
                    snackbar.Add(@languageContainer.Keys["LoginIsValid"], Severity.Success);
                    navigationManager.NavigateTo($"/dashboard");
                    return;
                }

                var user = await dataAccessEmployee.FindAsync(new SearcherEmployee()
                {
                     Username = userModel.Username,
                     Password = Cypher.Encrypt(userModel.Password)
                });

                if (user == null || user.Count == 0)
                {
                    snackbar.Add(@languageContainer.Keys["LoginIsNotValid"], Severity.Warning);
                    return;
                }

                if(user.First().EmployeeRole == EmployeeRole.None)
                {
                    snackbar.Add(@languageContainer.Keys["LoginIsNotValidUserDisabled"], Severity.Warning);
                    return;
                }

                await Utility.SaveCurrentLoggedEmployee(protectedLocalStorage, user.First());


                snackbar.Add(@languageContainer.Keys["LoginIsValid"], Severity.Success);
                navigationManager.NavigateTo($"/dashboard");
            }
        }catch(Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
        }   
          
    }

    // User model for form data binding
    public class UserModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
