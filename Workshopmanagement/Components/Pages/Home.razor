    #region StepTable
    private List<WorkflowStepView> GetStepsForDashboard()
    {
        if (selectedResumeItem == null) return new List<WorkflowStepView>();

        var entry = selectedResumeItem.Entry;
        var tasksForWorkflow = allWorkflowTasks
            .Where(t => t.WorkflowId == entry.WorkflowId)
            .OrderBy(t => t.TaskOrder)
            .ToList();

        var executionsForSeries = dashboardExecutions
            .Where(e => e.WorkflowExecutionSeriesId == entry.WorkflowExecutionSeriesId)
            .ToList();

        var usedExecutionIds = new HashSet<string>();
        var result = new List<WorkflowStepView>();

        foreach (var task in tasksForWorkflow)
        {
            var taskExecutions = executionsForSeries
                .Where(e => e.WorkflowTaskId == task.Id && !usedExecutionIds.Contains(e.Id))
                .OrderBy(e => e.OpenAt)
                .ToList();

            if (taskExecutions.Any())
            {
                foreach (var exec in taskExecutions)
                {
                    usedExecutionIds.Add(exec.Id);
                    result.Add(new WorkflowStepView
                    {
                        Task = task,
                        Execution = exec,
                        IsCurrentStep = exec.Id == entry.WorkflowExecutionId
                    });
                }
            }
            else
            {
                result.Add(new WorkflowStepView
                {
                    Task = task,
                    Execution = null,
                    IsCurrentStep = false
                });
            }
        }

        return result;
    }

    private bool CanEditStep(WorkflowStepView step)
    {
        if (step.Execution == null) return false;

        return step.IsCurrentStep
            || step.Execution.ExecutionStatus == WorkflowExecutionStatus.Todo
            || step.Execution.ExecutionStatus == WorkflowExecutionStatus.InProgress
            || step.Execution.Executionoutcome == WorkflowExecutionoutcome.RunningOut
            || step.Execution.Executionoutcome == WorkflowExecutionoutcome.ToBeVerified
            || step.Execution.Executionoutcome == WorkflowExecutionoutcome.ToBeReplaced;
    }

    private async Task DashboardOpenEditStepAsync(WorkflowStepView step)
    {
        try
        {
            if (step.Execution == null) return;

            var veichle = selectedResumeItem.Veichle;
            var entry = selectedResumeItem.Entry;
            var customer = await dbDependency.GetDataAccessCustomer().FindByIdAsync(veichle.UserId);
            var workflow = allWorkflows.FirstOrDefault(w => w.Id == entry.WorkflowId) ?? new Workflow();
            var components = await dbDependency.GetDataAccessComponent().FindAsync(new SearcherComponent()) ?? new List<Component>();

            var isCurrentStep = step.IsCurrentStep;
            var parameters = new DialogParameters<ResumeWorkflow> {
            {
                x => x.Dataset,
                new ResumeWorkflowDialogParameter()
                {
                    employee = employee,
                    customer = customer,
                    veichle = veichle,
                    workflow = workflow,
                    workflowTask = step.Task,
                    workflowExecution = step.Execution,
                    components = components,
                    editOneExecution = !isCurrentStep,
                    viewOneExecution = false
                }
            }
            };

            var dialog = await dialogService.ShowAsync<ResumeWorkflow>(@languageContainer.Keys["ResumingWorkflow"], parameters, dialogOptions);
            var result = await dialog.Result;

            if (!result?.Canceled ?? false)
            {
                // Reload vehicle and executions
                var updatedVeichle = await dbDependency.GetDataAccessVeichle().FindByIdAsync(veichle.Id);
                if (updatedVeichle != null)
                {
                    selectedResumeItem.Veichle = updatedVeichle;
                    var updatedEntry = updatedVeichle.OpenWorkflows?
                        .FirstOrDefault(e => e.WorkflowExecutionSeriesId == entry.WorkflowExecutionSeriesId);
                    if (updatedEntry != null)
                        selectedResumeItem.Entry = updatedEntry;
                }

                if (!string.IsNullOrEmpty(selectedResumeItem.Entry.WorkflowExecutionSeriesId))
                {
                    dashboardExecutions = await dbDependency.GetDataAccessWorkflowExecution().FindAsync(
                        new SearcherWorkflowExecution { WorkflowExecutionSeriesId = selectedResumeItem.Entry.WorkflowExecutionSeriesId });
                }
                await LoadDashboardTrackingState();
            }
        }
        catch (Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            StateHasChanged();
        }
    }

