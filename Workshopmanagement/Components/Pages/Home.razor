@page "/dashboard"

@inject IJSRuntime JSRuntime
@inject IDbDependency dbDependency
@inject ISnackbar snackbar
@inject ILanguageContainerService languageContainer
@inject IDialogService dialogService
@inject ProtectedLocalStorage protectedLocalStorage
@inject NavigationManager navigationManager

<MudGrid>
    <MudItem xs="12">
        <MudText Typo="Typo.h4">
            @languageContainer.Keys["HomeStartTitle"]
        </MudText>
    </MudItem>
    <MudItem xs ="6">
        <MudButton OnClick="OpenCreateWorkflowDialogAsync"
            StartIcon="@Icons.Material.Filled.Workspaces" Color="Color.Primary" Variant="Variant.Filled" Style="width: 100%; min-height: 120px; font-size: 1.1rem;">
            @languageContainer.Keys["HomeStartNewFlow"]
        </MudButton>
    </MudItem>
    <MudItem xs="6">
        <MudButton OnClick="HomeResumeWorkflow" 
            StartIcon="@Icons.Material.Filled.Start" Color="Color.Secondary" Variant="Variant.Filled" Style="width: 100%; min-height: 120px; font-size: 1.1rem;">
            @languageContainer.Keys["HomeResumeFlow"]
        </MudButton>
    </MudItem>
</MudGrid>

<MudMessageBox @ref="mudMessageBoxCustomer" Title="@languageContainer.Keys["HomeSelectCustomer"]" CancelText="@languageContainer.Keys["HomeSelectVeichleCancel"]">
    <MessageContent>
       <MudGrid>
           <MudItem xs="12">
                <MudList @bind-SelectedValue="selectedResumeCustomer" T="Customer" SelectionMode="SelectionMode.SingleSelection">
                    @foreach (var customer in resumeCustomers)
                    {
                        <MudListItem Text="@($"{customer.Name} {customer.Surname}{(customer.IsCompany && !string.IsNullOrEmpty(customer.BusinessName) ? $" - {customer.BusinessName}" : "")}")" Value="customer" Icon="@Icons.Material.Filled.Person" />
                    }
                </MudList>
           </MudItem>
       </MudGrid>
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward" Color="Color.Info">
            @languageContainer.Keys["HomeSelectVeichleProceed"]
        </MudButton>
    </YesButton>
</MudMessageBox>

<MudMessageBox @ref="mudMessageBoxVeichle" Title="@languageContainer.Keys["HomeSelectVeichle"]" CancelText="@languageContainer.Keys["HomeSelectVeichleCancel"]">
    <MessageContent>
       <MudGrid>
           <MudItem xs="12">
                <MudList @bind-SelectedValue="selectedResumeVeichle" T="Veichle" SelectionMode="SelectionMode.SingleSelection">
                    @foreach (var veichle in resumeVeichles)
                    {
                        <MudListItem Text="@($"{veichle.LicensePlate} - {veichle.Brand} {veichle.Model}")" Value="veichle" Icon="@Icons.Material.Filled.CarRepair" />
                    }
                </MudList>
           </MudItem>
       </MudGrid>
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward" Color="Color.Info">
            @languageContainer.Keys["HomeSelectVeichleProceed"]
        </MudButton>
    </YesButton>
</MudMessageBox>

<MudMessageBox @ref="mudMessageBoxFlow" Title="@languageContainer.Keys["HomeSelectFlow"]" CancelText="@languageContainer.Keys["HomeSelectVeichleCancel"]">
    <MessageContent>
       <MudGrid>
           <MudItem xs="12">
                <MudList @bind-SelectedValue="selectedResumeItem" T="ResumeWorkflowItem" SelectionMode="SelectionMode.SingleSelection">
                    @foreach (var item in resumeItems)
                    {
                        <MudListItem Value="item" Icon="@Icons.Material.Filled.Workspaces">
                            <div style="display:flex; align-items:center; gap:8px;">
                                <MudChip T="string" Style="@($"background-color:{item.WorkflowColor}; color:white;")" Size="Size.Small">@item.WorkflowTitle</MudChip>
                                <span style="font-size:0.875rem;">@item.WorkflowTaskTitle</span>
                            </div>
                        </MudListItem>
                    }
                </MudList>
           </MudItem>
       </MudGrid>
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward" Color="Color.Info">
            @languageContainer.Keys["HomeSelectVeichleProceed"]
        </MudButton>
    </YesButton>
</MudMessageBox>

@if (showNoAppointmentBanner)
{
    <MudGrid Class="mt-4">
        <MudItem xs="12">
            <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Icon="@Icons.Material.Filled.EventBusy">
                @languageContainer.Keys["HomeNoAppointmentScheduled"]
            </MudAlert>
        </MudItem>
    </MudGrid>
}

@if (showStepTable && selectedResumeItem != null)
{
    <MudGrid Class="mt-4">
        <MudItem xs="12">
            <MudCard Outlined="true" Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width: 100%;">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudChip T="string" Style="@($"background-color:{selectedResumeItem.WorkflowColor}; color:white;")" Size="Size.Small">@selectedResumeItem.WorkflowTitle</MudChip>
                                <MudText Typo="Typo.subtitle1">@($"{selectedResumeItem.Veichle.LicensePlate} - {selectedResumeItem.Veichle.Brand} {selectedResumeItem.Veichle.Model}")</MudText>
                                @{
                                    var dashEmpNames = GetDashboardEmployeeNames();
                                }
                                @if (!string.IsNullOrEmpty(dashEmpNames))
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@languageContainer.Keys["WorkflowColAssigned"]: @dashEmpNames</MudText>
                                }
                            </MudStack>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudText Typo="Typo.body2" Color="Color.Default">
                                    @languageContainer.Keys["TimeTrackingHoursSpent"]: @FormatDashboardTotalTime()
                                </MudText>
                                @{
                                    var isDashFuture = IsDashboardStartDateInFuture();
                                }
                                @if (isDashFuture)
                                {
                                    <MudTooltip Text="@languageContainer.Keys["WorkflowFutureScheduled"]">
                                        <MudChip T="string" Icon="@Icons.Material.Filled.Schedule" Color="Color.Warning" Size="Size.Small" Style="font-size:0.7rem;">@Utility.GetDateFormatted(GetDashboardStartDate(), Utility.DateFormat.OnlyDate)</MudChip>
                                    </MudTooltip>
                                }
                                else
                                {
                                    <MudButton OnClick="@(() => DashboardStartTrackingAsync())"
                                               StartIcon="@Icons.Material.Filled.PlayArrow" Variant="Variant.Filled"
                                               Color="Color.Success" Size="Size.Small"
                                               Disabled="@isDashboardTrackingActive"
                                               Style="@(isDashboardTrackingActive ? "opacity: 0.3; min-width: 40px;" : "min-width: 40px;")" />
                                    <MudButton OnClick="@(() => DashboardStopTrackingAsync())"
                                               StartIcon="@Icons.Material.Filled.Stop" Variant="Variant.Filled"
                                               Color="Color.Error" Size="Size.Small"
                                               Disabled="@(!isDashboardTrackingActive)"
                                               Style="@(!isDashboardTrackingActive ? "opacity: 0.3; min-width: 40px;" : "min-width: 40px;")" />
                                }
                            </MudStack>
                        </MudStack>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="padding: 8px;">
                    <MudSimpleTable Dense="true" Hover="true" Bordered="true" Striped="true" Style="background-color: transparent; width: 100%;">
                        <thead>
                            <tr>
                                <th style="width: 90px;"></th>
                                <th style="width: 60px; text-align: center;">@languageContainer.Keys["StepCompleted"]</th>
                                <th>@languageContainer.Keys["StepTitleHistory"]</th>
                                <th>@languageContainer.Keys["StepTitleExHistory"]</th>
                                <th style="width: 60px; text-align: center;">@languageContainer.Keys["StepTitleStatus"]</th>
                                <th style="width: 60px; text-align: center;">@languageContainer.Keys["StepTitleOutcome"]</th>
                                <th>@languageContainer.Keys["OpenAt"]</th>
                                <th>@languageContainer.Keys["ClosedAt"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var step in GetStepsForDashboard())
                            {
                                if (step.Task.TaskOrder < 0)
                                    continue;
                                <tr style="@(step.IsCurrentStep ? "background-color: rgba(28, 144, 243, 0.12); font-weight: 500;" : "")">
                                    <td>
                                        <MudStack Row="true" Spacing="1">
                                            @if (step.Execution != null && CanEditStep(step))
                                            {
                                                <MudIconButton OnClick="@(() => DashboardOpenEditStepAsync(step))"
                                                               Color="Color.Warning" Size="@Size.Small"
                                                               Icon="@Icons.Material.Filled.Edit" Variant="Variant.Outlined" />
                                            }
                                            @if (step.Execution != null && step.Task.AllowLoop && CanEditStep(step))
                                            {
                                                <MudIconButton OnClick="@(() => DashboardDuplicateStepAsync(step))"
                                                               Color="Color.Success" Size="@Size.Small"
                                                               Icon="@Icons.Material.Filled.ContentCopy" Variant="Variant.Outlined"
                                                               Title="Duplica" />
                                            }
                                            @if (step.Execution != null && !CanEditStep(step))
                                            {
                                                <MudIconButton OnClick="@(() => DashboardOpenViewStepAsync(step))"
                                                               Color="Color.Info" Size="@Size.Small"
                                                               Icon="@Icons.Material.Filled.RemoveRedEye" Variant="Variant.Outlined" />
                                            }
                                        </MudStack>
                                    </td>
                                    <td style="text-align: center;">
                                        @if (step.Execution != null && step.Execution.IsCompleted)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                        }
                                    </td>
                                    <td>@Utility.TruncateFroHtml(step.Task.Title, 40)</td>
                                    <td>@(step.Execution != null ? Utility.TruncateFroHtml(step.Execution.Titile, 40) : "-")</td>
                                    <td style="text-align: center;">
                                        @if (step.Execution != null)
                                        {
                                            @if (step.Execution.ExecutionStatus == WorkflowExecutionStatus.InProgress)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled._360" Color="Color.Info" Size="Size.Small" />
                                            }
                                            else if (step.Execution.ExecutionStatus == WorkflowExecutionStatus.Todo)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.AssignmentReturned" Color="Color.Default" Size="Size.Small" />
                                            }
                                            else if (step.Execution.ExecutionStatus == WorkflowExecutionStatus.Skipped)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.AirlineStops" Color="Color.Warning" Size="Size.Small" />
                                            }
                                            else if (step.Execution.ExecutionStatus == WorkflowExecutionStatus.Closed)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Color="Color.Success" Size="Size.Small" />
                                            }
                                        }
                                        else
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Default" Size="Size.Small" />
                                        }
                                    </td>
                                    <td style="text-align: center;">
                                        @if (step.Execution != null)
                                        {
                                            @if (step.Execution.Executionoutcome == WorkflowExecutionoutcome.RunningOut)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.GasMeter" Color="Color.Warning" Size="Size.Small" />
                                            }
                                            else if (step.Execution.Executionoutcome == WorkflowExecutionoutcome.ToBeReplaced)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Build" Color="Color.Warning" Size="Size.Small" />
                                            }
                                            else if (step.Execution.Executionoutcome == WorkflowExecutionoutcome.ToBeVerified)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Engineering" Color="Color.Warning" Size="Size.Small" />
                                            }
                                            else if (step.Execution.Executionoutcome == WorkflowExecutionoutcome.Replaced)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.ThumbUp" Color="Color.Success" Size="Size.Small" />
                                            }
                                            else if (step.Execution.Executionoutcome == WorkflowExecutionoutcome.Verified)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Done" Color="Color.Success" Size="Size.Small" />
                                            }
                                            else if (step.Execution.Executionoutcome == WorkflowExecutionoutcome.Ok)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.DoneAll" Color="Color.Success" Size="Size.Small" />
                                            }
                                        }
                                    </td>
                                    <td>@(step.Execution != null ? Utility.GetDateFormatted(step.Execution.OpenAt, Utility.DateFormat.FullDate) : "")</td>
                                    <td>@(step.Execution != null ? Utility.GetDateFormatted(step.Execution.ClosedAt, Utility.DateFormat.FullDate) : "")</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    private Employee employee;
    private DialogOptions dialogOptions = new DialogOptions
        {
            FullScreen = true,
            CloseButton = true,
            CloseOnEscapeKey = true
        };
    private MudMessageBox mudMessageBoxCustomer;
    private MudMessageBox mudMessageBoxVeichle;
    private MudMessageBox mudMessageBoxFlow;
    private DialogOptions mudMessageBoxOption = new() { BackdropClick = false };

    private List<Customer> resumeCustomers = new List<Customer>();
    private Customer selectedResumeCustomer;

    private List<Veichle> resumeVeichles = new List<Veichle>();
    private Veichle selectedResumeVeichle;

    private List<ResumeWorkflowItem> resumeItems = new List<ResumeWorkflowItem>();
    private ResumeWorkflowItem selectedResumeItem;

    private List<Veichle> allOpenVeichles = new List<Veichle>();
    private List<Workflow> allWorkflows = new List<Workflow>();
    private List<WorkflowTask> allWorkflowTasks = new List<WorkflowTask>();
    private List<Employee> allEmployees = new List<Employee>();

    private bool processing = true;
    private bool showStepTable = false;
    private bool showNoAppointmentBanner = false;
    private List<WorkflowExecution> dashboardExecutions = new List<WorkflowExecution>();

    // Time tracking
    private TimeTracking? dashboardTimeTracking = null;
    private bool isDashboardTrackingActive = false;

    private class ResumeWorkflowItem
    {
        public Veichle Veichle { get; set; }
        public OpenWorkflowEntry Entry { get; set; }
        public string WorkflowTitle { get; set; }
        public string WorkflowColor { get; set; }
        public string WorkflowTaskTitle { get; set; }
    }

    private class WorkflowStepView
    {
        public WorkflowTask Task { get; set; } = new WorkflowTask();
        public WorkflowExecution? Execution { get; set; }
        public bool IsCurrentStep { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            var isUserLogged = await Utility.IsUserLoggedInAsync(protectedLocalStorage);
            if (!isUserLogged)
            {
                snackbar.Add(@languageContainer.Keys["LoginExpiredError"], Severity.Warning);
                navigationManager.NavigateTo($"login");
            }

            employee = await Utility.GetCurrentLoggedEmployee(protectedLocalStorage);

            if (firstRender)
            {
                await PreloadMostRecentWorkflow();
            }
        }catch(Exception ex)
        {
            if (!ex.Message.Contains("was not found in the key ring. For more information go to https://aka.ms/aspnet/dataprotectionwarning"))
                snackbar.Add(ex.Message, Severity.Error);
        }      

    }

    private async Task PreloadMostRecentWorkflow()
    {
        try
        {
            allOpenVeichles = await dbDependency.GetDataAccessVeichle().FindAsync(new SearcherVeichle { HasOpenWorkflow = true });
            allWorkflows = await dbDependency.GetDataAccessWorkflow().FindAsync(new SearcherWorkflow());
            allWorkflowTasks = await dbDependency.GetDataAccessWorkflowTask().FindAsync(new SearcherWorkflowTask());
            allEmployees = await dbDependency.GetDataAccessEmployee().FindAsync(new SearcherEmployee());

            // Collect all open workflow entries across all vehicles
            var allEntries = allOpenVeichles
                .Where(v => v.OpenWorkflows != null && v.OpenWorkflows.Any())
                .SelectMany(v => v.OpenWorkflows.Select(e => new { Veichle = v, Entry = e }))
                .ToList();

            // If no open entries at all → show banner
            if (!allEntries.Any())
            {
                showNoAppointmentBanner = true;
                StateHasChanged();
                return;
            }

            ResumeWorkflowItem? bestItem = null;
            List<WorkflowExecution> bestExecutions = new();

            if (employee != null)
            {
                // --- Priority 1: Active tracking session for the current employee ---
                var activeTrackings = await dbDependency.GetDataAccessTimeTracking().FindAsync(
                    new SearcherTimeTracking { EmployeeId = employee.Id, IsActive = true });
                var activeTracking = activeTrackings.FirstOrDefault();

                if (activeTracking != null)
                {
                    var matchedEntry = allEntries.FirstOrDefault(
                        e => e.Entry.WorkflowExecutionSeriesId == activeTracking.WorkflowExecutionSeriesId);

                    if (matchedEntry != null)
                    {
                        var executions = await dbDependency.GetDataAccessWorkflowExecution().FindAsync(
                            new SearcherWorkflowExecution { WorkflowExecutionSeriesId = matchedEntry.Entry.WorkflowExecutionSeriesId });
                        var wf = allWorkflows.FirstOrDefault(w => w.Id == matchedEntry.Entry.WorkflowId);
                        var wfTask = allWorkflowTasks.FirstOrDefault(t => t.Id == matchedEntry.Entry.WorkflowTaskId);
                        bestItem = new ResumeWorkflowItem
                        {
                            Veichle = matchedEntry.Veichle,
                            Entry = matchedEntry.Entry,
                            WorkflowTitle = wf?.Title ?? "",
                            WorkflowColor = wf?.Color ?? "#607D8B",
                            WorkflowTaskTitle = wfTask?.Title ?? ""
                        };
                        bestExecutions = executions;
                    }
                }

                // --- Priority 2: Most recent series where the user has tracked time (not active, series still open) ---
                if (bestItem == null)
                {
                    var allTrackings = await dbDependency.GetDataAccessTimeTracking().FindAsync(
                        new SearcherTimeTracking { EmployeeId = employee.Id });

                    var recentTracking = allTrackings
                        .Where(t => allEntries.Any(e => e.Entry.WorkflowExecutionSeriesId == t.WorkflowExecutionSeriesId))
                        .OrderByDescending(t => t.Sessions.LastOrDefault()?.StartTime ?? DateTime.MinValue)
                        .FirstOrDefault();

                    if (recentTracking != null)
                    {
                        var matchedEntry = allEntries.FirstOrDefault(
                            e => e.Entry.WorkflowExecutionSeriesId == recentTracking.WorkflowExecutionSeriesId);

                        if (matchedEntry != null)
                        {
                            var executions = await dbDependency.GetDataAccessWorkflowExecution().FindAsync(
                                new SearcherWorkflowExecution { WorkflowExecutionSeriesId = matchedEntry.Entry.WorkflowExecutionSeriesId });
                            var wf = allWorkflows.FirstOrDefault(w => w.Id == matchedEntry.Entry.WorkflowId);
                            var wfTask = allWorkflowTasks.FirstOrDefault(t => t.Id == matchedEntry.Entry.WorkflowTaskId);
                            bestItem = new ResumeWorkflowItem
                            {
                                Veichle = matchedEntry.Veichle,
                                Entry = matchedEntry.Entry,
                                WorkflowTitle = wf?.Title ?? "",
                                WorkflowColor = wf?.Color ?? "#607D8B",
                                WorkflowTaskTitle = wfTask?.Title ?? ""
                            };
                            bestExecutions = executions;
                        }
                    }
                }
            }

            // --- Priority 3: Next available open execution (nearest StartDate to today) ---
            if (bestItem == null)
            {
                double bestDistance = double.MaxValue;

                foreach (var item in allEntries)
                {
                    if (string.IsNullOrEmpty(item.Entry.WorkflowExecutionSeriesId)) continue;

                    var executions = await dbDependency.GetDataAccessWorkflowExecution().FindAsync(
                        new SearcherWorkflowExecution { WorkflowExecutionSeriesId = item.Entry.WorkflowExecutionSeriesId });

                    var startDate = executions.FirstOrDefault()?.StartDate;
                    double distance = startDate.HasValue
                        ? Math.Abs((startDate.Value.Date - DateTime.Today).TotalDays)
                        : double.MaxValue - 1; // no StartDate: prefer over entries with no executions, but after dated ones

                    if (distance < bestDistance)
                    {
                        bestDistance = distance;
                        var wf = allWorkflows.FirstOrDefault(w => w.Id == item.Entry.WorkflowId);
                        var wfTask = allWorkflowTasks.FirstOrDefault(t => t.Id == item.Entry.WorkflowTaskId);
                        bestItem = new ResumeWorkflowItem
                        {
                            Veichle = item.Veichle,
                            Entry = item.Entry,
                            WorkflowTitle = wf?.Title ?? "",
                            WorkflowColor = wf?.Color ?? "#607D8B",
                            WorkflowTaskTitle = wfTask?.Title ?? ""
                        };
                        bestExecutions = executions;
                    }
                }
            }

            if (bestItem != null)
            {
                selectedResumeItem = bestItem;
                dashboardExecutions = bestExecutions;
                showStepTable = true;
                await LoadDashboardTrackingState();
                StateHasChanged();
            }
            else
            {
                showNoAppointmentBanner = true;
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            // Silently fail preload - user can still manually select
        }
    }

    private async Task OpenCreateWorkflowDialogAsync()
    {
        try
        {
            processing = true;

            var parameters = new DialogParameters<StartNewWorkflow> {
            {
                x => x.Dataset,
                new StartWorkflowDialogParameter()
                {
                    employee = employee,
                    customers = await dbDependency.GetDataAccessCustomer().FindAsync(new SearcherCustomer()),
                    veichles =  await dbDependency.GetDataAccessVeichle().FindAsync(new SearcherVeichle()),
                    workflows = await dbDependency.GetDataAccessWorkflow().FindAsync(new SearcherWorkflow()),
                    workflowTasks = await dbDependency.GetDataAccessWorkflowTask().FindAsync(new SearcherWorkflowTask())
                }
            }
        };

            var dialog = await dialogService.ShowAsync<StartNewWorkflow>(@languageContainer.Keys["StartingNewWorkflow"], parameters, dialogOptions);
            var result = await dialog.Result;

        }
        catch (Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            processing = false;
            StateHasChanged();
        }
    }

    private async Task HomeResumeWorkflow()
    {
        try
        {
            processing = true;

            allOpenVeichles = await dbDependency.GetDataAccessVeichle().FindAsync(new SearcherVeichle()
            {
                 HasOpenWorkflow = true
            });
            allWorkflows = await dbDependency.GetDataAccessWorkflow().FindAsync(new SearcherWorkflow());
            allWorkflowTasks = await dbDependency.GetDataAccessWorkflowTask().FindAsync(new SearcherWorkflowTask());
            allEmployees = await dbDependency.GetDataAccessEmployee().FindAsync(new SearcherEmployee());
            var customers = await dbDependency.GetDataAccessCustomer().FindAsync(new SearcherCustomer());

            // Get distinct customer IDs from vehicles with open workflows
            var customerIds = allOpenVeichles.Select(v => v.UserId).Distinct().ToList();
            resumeCustomers = customers.Where(c => customerIds.Contains(c.Id)).ToList();

            selectedResumeCustomer = null;
            selectedResumeVeichle = null;
            selectedResumeItem = null;

            processing = false;
            StateHasChanged();

            // Step 1: Select customer
            var customerResult = await mudMessageBoxCustomer.ShowAsync(mudMessageBoxOption);
            if (customerResult != true)
                return;

            if (selectedResumeCustomer == null || string.IsNullOrEmpty(selectedResumeCustomer.Id))
            {
                snackbar.Add(languageContainer.Keys["HomeNoCustomerSelected"], Severity.Warning);
                return;
            }

            // Filter vehicles for the selected customer
            resumeVeichles = allOpenVeichles
                .Where(v => v.UserId == selectedResumeCustomer.Id && v.HasOpenWorkflow && v.OpenWorkflows != null && v.OpenWorkflows.Any())
                .ToList();

            if (!resumeVeichles.Any())
            {
                snackbar.Add(languageContainer.Keys["HomeNoVeichlesForCustomer"], Severity.Warning);
                return;
            }

            selectedResumeVeichle = null;
            selectedResumeItem = null;
            StateHasChanged();

            // Step 2: Select vehicle
            var veichleResult = await mudMessageBoxVeichle.ShowAsync(mudMessageBoxOption);
            if (veichleResult != true)
                return;

            if (selectedResumeVeichle == null || string.IsNullOrEmpty(selectedResumeVeichle.Id))
            {
                snackbar.Add(languageContainer.Keys["HomeNoVeichleSelected"], Severity.Warning);
                return;
            }

            // Build flow items for the selected vehicle
            resumeItems = selectedResumeVeichle.OpenWorkflows
                .Select(entry =>
                {
                    var wf = allWorkflows.FirstOrDefault(w => w.Id == entry.WorkflowId);
                    var wfTask = allWorkflowTasks.FirstOrDefault(t => t.Id == entry.WorkflowTaskId);
                    return new ResumeWorkflowItem
                    {
                        Veichle = selectedResumeVeichle,
                        Entry = entry,
                        WorkflowTitle = wf?.Title ?? "",
                        WorkflowColor = wf?.Color ?? "#607D8B",
                        WorkflowTaskTitle = wfTask?.Title ?? ""
                    };
                })
                .ToList();

            if (!resumeItems.Any())
            {
                snackbar.Add(languageContainer.Keys["HomeNoOpenFlows"], Severity.Warning);
                return;
            }

            selectedResumeItem = null;
            StateHasChanged();

            // Step 3: Select flow
            var flowResult = await mudMessageBoxFlow.ShowAsync(mudMessageBoxOption);
            if (flowResult != true)
                return;

            if (selectedResumeItem == null || string.IsNullOrEmpty(selectedResumeItem.Veichle?.Id))
            {
                snackbar.Add(languageContainer.Keys["HomeNoFlowSelected"], Severity.Warning);
                return;
            }

            // Load executions for selected workflow and show step table
            dashboardExecutions = new List<WorkflowExecution>();
            if (!string.IsNullOrEmpty(selectedResumeItem.Entry.WorkflowExecutionSeriesId))
            {
                dashboardExecutions = await dbDependency.GetDataAccessWorkflowExecution().FindAsync(
                    new SearcherWorkflowExecution { WorkflowExecutionSeriesId = selectedResumeItem.Entry.WorkflowExecutionSeriesId });
            }
            showStepTable = true;
            await LoadDashboardTrackingState();
        }
        catch (Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            processing = false;
            StateHasChanged();
        }
    }

    #region TimeTracking
    private async Task LoadDashboardTrackingState()
    {
        isDashboardTrackingActive = false;
        dashboardTimeTracking = null;

        if (employee == null || selectedResumeItem == null) return;

        var seriesId = selectedResumeItem.Entry.WorkflowExecutionSeriesId;
        if (string.IsNullOrEmpty(seriesId)) return;

        var trackings = await dbDependency.GetDataAccessTimeTracking().FindAsync(
            new SearcherTimeTracking { EmployeeId = employee.Id, WorkflowExecutionSeriesId = seriesId });
        dashboardTimeTracking = trackings.FirstOrDefault();

        if (dashboardTimeTracking != null && dashboardTimeTracking.IsActive)
        {
            isDashboardTrackingActive = true;
        }
    }

    private async Task DashboardStartTrackingAsync()
    {
        try
        {
            if (employee == null || selectedResumeItem == null) return;
            var seriesId = selectedResumeItem.Entry.WorkflowExecutionSeriesId;
            var employeeId = employee.Id;

            // Check if user has another active tracking
            var activeTrackings = await dbDependency.GetDataAccessTimeTracking().FindAsync(
                new SearcherTimeTracking { EmployeeId = employeeId, IsActive = true });
            var otherActive = activeTrackings.FirstOrDefault(t => t.WorkflowExecutionSeriesId != seriesId);

            if (otherActive != null)
            {
                bool? result = await dialogService.ShowMessageBox(
                    languageContainer.Keys["TimeTrackingAlreadyActiveTitle"],
                    languageContainer.Keys["TimeTrackingAlreadyActiveDescription"],
                    yesText: languageContainer.Keys["Yes"], cancelText: languageContainer.Keys["No"]);

                if (result != true)
                    return;

                // Stop the other active tracking
                var activeSession = otherActive.Sessions.LastOrDefault();
                if (activeSession != null && activeSession.EndTime == null)
                    activeSession.EndTime = DateTime.Now;
                otherActive.IsActive = false;
                await dbDependency.GetDataAccessTimeTracking().UpdateAsync(otherActive);
            }

            // Start tracking
            if (dashboardTimeTracking != null)
            {
                dashboardTimeTracking.IsActive = true;
                dashboardTimeTracking.Sessions.Add(new TimeTrackingSession { StartTime = DateTime.Now });
                await dbDependency.GetDataAccessTimeTracking().UpdateAsync(dashboardTimeTracking);
            }
            else
            {
                dashboardTimeTracking = new TimeTracking
                {
                    Id = Guid.NewGuid().ToString(),
                    EmployeeId = employeeId,
                    WorkflowExecutionSeriesId = seriesId,
                    IsActive = true,
                    Sessions = new List<TimeTrackingSession>
                    {
                        new TimeTrackingSession { StartTime = DateTime.Now }
                    }
                };
                await dbDependency.GetDataAccessTimeTracking().InsertAsync(dashboardTimeTracking);
            }

            isDashboardTrackingActive = true;
            snackbar.Add(languageContainer.Keys["TimeTrackingStarted"], Severity.Success);

            // Add employee to AssignedEmployeeIds on the current execution
            var startExecution = dashboardExecutions.FirstOrDefault(e => e.Id == selectedResumeItem.Entry.WorkflowExecutionId);
            if (startExecution != null)
            {
                if (startExecution.AssignedEmployeeIds == null)
                    startExecution.AssignedEmployeeIds = new List<string>();
                if (!startExecution.AssignedEmployeeIds.Contains(employeeId))
                {
                    startExecution.AssignedEmployeeIds.Add(employeeId);
                    await dbDependency.GetDataAccessWorkflowExecution().UpdateAsync(startExecution);
                }
            }
        }
        catch (Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DashboardStopTrackingAsync()
    {
        try
        {
            if (dashboardTimeTracking == null) return;

            var activeSession = dashboardTimeTracking.Sessions.LastOrDefault();
            if (activeSession != null && activeSession.EndTime == null)
                activeSession.EndTime = DateTime.Now;

            dashboardTimeTracking.IsActive = false;
            await dbDependency.GetDataAccessTimeTracking().UpdateAsync(dashboardTimeTracking);

            isDashboardTrackingActive = false;

            // Remove employee from AssignedEmployeeIds on the current execution
            if (employee != null && selectedResumeItem != null)
            {
                var stopExecution = dashboardExecutions.FirstOrDefault(e => e.Id == selectedResumeItem.Entry.WorkflowExecutionId);
                if (stopExecution != null && stopExecution.AssignedEmployeeIds != null)
                {
                    stopExecution.AssignedEmployeeIds.Remove(employee.Id);
                    await dbDependency.GetDataAccessWorkflowExecution().UpdateAsync(stopExecution);
                }
            }

            StateHasChanged();
            snackbar.Add(languageContainer.Keys["TimeTrackingStopped"], Severity.Info);
        }
        catch (Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private string FormatDashboardTotalTime()
    {
        if (dashboardTimeTracking == null) return "00:00:00";
        var total = TimeSpan.FromTicks(dashboardTimeTracking.Sessions
            .Where(s => s.EndTime.HasValue)
            .Sum(s => (s.EndTime!.Value - s.StartTime).Ticks));
        return $"{(int)total.TotalHours:D2}:{total.Minutes:D2}:{total.Seconds:D2}";
    }

    private DateTime? GetDashboardStartDate()
    {
        return dashboardExecutions.FirstOrDefault()?.StartDate;
    }

    private bool IsDashboardStartDateInFuture()
    {
        var startDate = GetDashboardStartDate();
        return startDate.HasValue && startDate.Value.Date > DateTime.Today;
    }

    private string GetDashboardEmployeeNames()
    {
        if (dashboardExecutions == null || !dashboardExecutions.Any()) return "";
        var employeeIds = dashboardExecutions
            .Where(e => e.AssignedEmployeeIds != null)
            .SelectMany(e => e.AssignedEmployeeIds!)
            .Distinct()
            .ToList();
        if (!employeeIds.Any()) return "";
        var names = employeeIds
            .Select(id => allEmployees.FirstOrDefault(emp => emp.Id == id))
            .Where(emp => emp != null)
            .Select(emp => $"{emp!.Name} {emp.Surname}")
            .ToList();
        return names.Any() ? string.Join(", ", names) : "";
    }

