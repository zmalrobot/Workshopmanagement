@page "/dashboard"

@inject IJSRuntime JSRuntime
@inject IDbDependency dbDependency
@inject ISnackbar snackbar
@inject ILanguageContainerService languageContainer
@inject IDialogService dialogService
@inject ProtectedLocalStorage protectedLocalStorage
@inject NavigationManager navigationManager

<MudGrid>
    <MudItem xs="12">
        <MudText Typo="Typo.h4">
            @languageContainer.Keys["HomeStartTitle"]
        </MudText>
    </MudItem>
    <MudItem xs ="6">
        <MudButton OnClick="OpenCreateWorkflowDialogAsync"
            StartIcon="@Icons.Material.Filled.Workspaces" Color="Color.Primary" Variant="Variant.Filled" Style="width: 100%; height: 600%">
            @languageContainer.Keys["HomeStartNewFlow"]
        </MudButton>
    </MudItem>
    <MudItem xs="6">
        <MudButton OnClick="HomeResumeWorkflow" 
            StartIcon="@Icons.Material.Filled.Start" Color="Color.Secondary" Variant="Variant.Filled" Style="width: 100%; height: 600%">
            @languageContainer.Keys["HomeResumeFlow"]
        </MudButton>
    </MudItem>
</MudGrid>

<MudMessageBox @ref="mudMessageBox" Title="@languageContainer.Keys["HomeSelectVeichle"]" CancelText="Cancel">
    <MessageContent>
       <MudGrid>
           <MudItem xs="12">
                <MudList @bind-SelectedValue="selectedResumeItem" T="ResumeWorkflowItem" SelectionMode="SelectionMode.SingleSelection">
                    @foreach (var item in resumeItems)
                    {
                        <MudListItem Text="@($"{item.Veichle.LicensePlate} - {item.WorkflowTitle}")" Value="item" Icon="@Icons.Material.Filled.CarRepair" />
                    }
                </MudList>
           </MudItem>
       </MudGrid>
    </MessageContent>
    <YesButton>
        <MudButton OnClick="ResumeWorkflow" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward" Color="Color.Info">
            @languageContainer.Keys["HomeSelectVeichleProceed"]
        </MudButton>
    </YesButton>
</MudMessageBox>

@code {
    private Employee employee;
    private DialogOptions dialogOptions = new DialogOptions
        {
            FullScreen = true,
            CloseButton = true,
            CloseOnEscapeKey = true
        };
    private MudMessageBox mudMessageBox;
    private DialogOptions mudMessageBoxOption = new() { BackdropClick = false };
    private List<ResumeWorkflowItem> resumeItems = new List<ResumeWorkflowItem>();
    private ResumeWorkflowItem selectedResumeItem;

    private bool processing = true;

    private class ResumeWorkflowItem
    {
        public Veichle Veichle { get; set; }
        public OpenWorkflowEntry Entry { get; set; }
        public string WorkflowTitle { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            var isUserLogged = await Utility.IsUserLoggedInAsync(protectedLocalStorage);
            if (!isUserLogged)
            {
                snackbar.Add(@languageContainer.Keys["LoginExpiredError"], Severity.Warning);
                navigationManager.NavigateTo($"login");
            }

            employee = await Utility.GetCurrentLoggedEmployee(protectedLocalStorage);
        }catch(Exception ex)
        {
            if (!ex.Message.Contains("was not found in the key ring. For more information go to https://aka.ms/aspnet/dataprotectionwarning"))
                snackbar.Add(ex.Message, Severity.Error);
        }      

    }

    private async Task OpenCreateWorkflowDialogAsync()
    {
        try
        {
            processing = true;

            var parameters = new DialogParameters<StartNewWorkflow> {
            {
                x => x.Dataset,
                new StartWorkflowDialogParameter()
                {
                    employee = employee,
                    customers = await dbDependency.GetDataAccessCustomer().FindAsync(new SearcherCustomer()),
                    veichles =  await dbDependency.GetDataAccessVeichle().FindAsync(new SearcherVeichle()),
                    workflows = await dbDependency.GetDataAccessWorkflow().FindAsync(new SearcherWorkflow()),
                    workflowTasks = await dbDependency.GetDataAccessWorkflowTask().FindAsync(new SearcherWorkflowTask())
                }
            }
        };

            var dialog = await dialogService.ShowAsync<StartNewWorkflow>(@languageContainer.Keys["StartingNewWorkflow"], parameters, dialogOptions);
            var result = await dialog.Result;

        }
        catch (Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            processing = false;
            StateHasChanged();
        }
    }

    private async Task HomeResumeWorkflow()
    {
        try
        {
            processing = true;
            var veichles = await dbDependency.GetDataAccessVeichle().FindAsync(new SearcherVeichle()
            {
                 HasOpenWorkflow = true
            });
            var workflows = await dbDependency.GetDataAccessWorkflow().FindAsync(new SearcherWorkflow());

            resumeItems = veichles
                .Where(v => v.OpenWorkflows != null)
                .SelectMany(v => v.OpenWorkflows.Select(entry => new ResumeWorkflowItem
                {
                    Veichle = v,
                    Entry = entry,
                    WorkflowTitle = workflows.FirstOrDefault(w => w.Id == entry.WorkflowId)?.Title ?? ""
                }))
                .ToList();

            var result = await mudMessageBox.ShowAsync(mudMessageBoxOption);         
        }
        catch (Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            processing = false;
            StateHasChanged();
        }
    }

    private async Task ResumeWorkflow()
    {
        try
        {
            processing = true;

            if(selectedResumeItem == null || String.IsNullOrEmpty(selectedResumeItem.Veichle?.Id))
            {
                snackbar.Add(languageContainer.Keys["HomeNoVeichleSelected"], Severity.Warning);
                return;
            }

            var selectedVeichle = selectedResumeItem.Veichle;
            var entry = selectedResumeItem.Entry;

            var customer = await dbDependency.GetDataAccessCustomer().FindByIdAsync(selectedVeichle.UserId);
            var workflow = await dbDependency.GetDataAccessWorkflow().FindByIdAsync(entry.WorkflowId);
            var workflowTask = await dbDependency.GetDataAccessWorkflowTask().FindByIdAsync(entry.WorkflowTaskId);
            var workflowExecution = await dbDependency.GetDataAccessWorkflowExecution().FindByIdAsync(entry.WorkflowExecutionId);
            var components = await dbDependency.GetDataAccessComponent().FindAsync(new SearcherComponent()) ?? new List<Component>();

            var parameters = new DialogParameters<ResumeWorkflow> {
            {
                x => x.Dataset,
                    new ResumeWorkflowDialogParameter()
                    {
                        employee = employee,
                        customer = customer,
                        veichle = selectedVeichle,
                        workflow = workflow,
                        workflowTask = workflowTask,
                        workflowExecution = workflowExecution, //Deve esistere,
                        components = components
                    }
                }
            };

            var dialog = await dialogService.ShowAsync<ResumeWorkflow>(@languageContainer.Keys["ResumingWorkflow"], parameters, dialogOptions);
            var result = await dialog.Result;
        }
        catch (Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            processing = false;
            StateHasChanged();
        }
    }
}

