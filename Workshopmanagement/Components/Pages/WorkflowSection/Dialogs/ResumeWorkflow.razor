    private async Task CommittedItemChanges(Component item)
    {

        try
        {
            if (Dataset.workflowExecution.Components == null)
                Dataset.workflowExecution.Components = new List<Component>();

            var element = Dataset.workflowExecution.Components.FirstOrDefault(x => x.Id.Equals(item.Id));

            if(element == null)
            {
                item.Id = Guid.NewGuid().ToString();
                Dataset.workflowExecution.Components.Add(item);
            }           
            else
            {
                element.Name = item.Name;
                element.PricePerQuantity = item.PricePerQuantity;
                element.Quanity = item.Quanity;
                element.UnitOfMeasurement = item.UnitOfMeasurement;
            }
        }
        catch (Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteItem(Component item)
    {

        try
        {
            if (Dataset.workflowExecution.Components == null)
                Dataset.workflowExecution.Components = new List<Component>();

            var element = Dataset.workflowExecution.Components.FirstOrDefault(x => x.Id.Equals(item.Id));
            if (element != null)
            {
                Dataset.workflowExecution.Components.Remove(element);
            }
        }
        catch (Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
        }
    }
