    private async Task UpdateSelectedComponent(Component component)
    {
        try
        {
            if(component == null)
                component = new Component();

            selectedComponent = component;
        }
        catch (Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);

        }
    }
    
    private async Task<IEnumerable<Component>> SearchComponent(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
            return Dataset.components;
        return Dataset.components.Where(x => x.Barcode.Contains(value, StringComparison.InvariantCultureIgnoreCase)
                                    || x.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase));
    }

