
@inject IJSRuntime JSRuntime
@inject IDbDependency dbDependency
@inject ISnackbar snackbar
@inject ILanguageContainerService languageContainer
@inject IDialogService dialogService
@inject ProtectedLocalStorage protectedLocalStorage
@inject NavigationManager navigationManager

<MudDialog Style="min-width: min(95vw, 820px);">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Workspaces" Color="Color.Info" />
            <MudText Typo="Typo.h6">@Dataset.workflow.Title</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        @if (processing)
        {
            <MudContainer Style="text-align: center; margin-top: 50px;">
                <MudProgressLinear Color="Color.Tertiary" Size="Size.Large" Indeterminate="true" />
            </MudContainer>
        }
        else
        {
            <MudStack Spacing="3">

                @* ── Step info header ──*@
                <MudCard Elevation="0" Outlined="true" Style="border-radius: 12px;">
                    <MudCardContent Class="pa-3">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="7">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Task" Color="Color.Success" Size="Size.Small" />
                                    <MudText Typo="Typo.subtitle1" Color="Color.Success" Style="font-weight:600;">@Dataset.workflowTask.Title</MudText>
                                </MudStack>
                                @if (!string.IsNullOrWhiteSpace(Dataset.workflowTask.Subtitle))
                                {
                                    <MudText Typo="Typo.body2" Color="Color.Success" Class="ml-5">@Dataset.workflowTask.Subtitle</MudText>
                                }
                                @if (!string.IsNullOrWhiteSpace(Dataset.workflowTask.Description))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Default" Class="ml-5 mt-1">@Dataset.workflowTask.Description</MudText>
                                }
                            </MudItem>
                            <MudItem xs="12" sm="5">
                                <MudStack Spacing="1">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.CarRental" Size="Size.Small" Color="Color.Default" />
                                        <MudText Typo="Typo.caption">@Dataset.veichle.LicensePlate</MudText>
                                    </MudStack>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Color="Color.Default" />
                                        <MudText Typo="Typo.caption">@Dataset.customer.Name @Dataset.customer.Surname</MudText>
                                    </MudStack>
                                </MudStack>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>

                @* ── Main fields card ──*@
                <MudCard Elevation="0" Outlined="true" Style="border-radius: 12px;">
                    <MudCardContent Class="pa-3">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="Dataset.workflowExecution.Titile" Margin="Margin.Dense" Disabled="@IsEditDisabled()"
                                              Label="@languageContainer.Keys["StepTitle"]" Variant="Variant.Outlined" />
                                @if (Dataset.workflowTask.HasOutcome)
                                {
                                    <MudSelect @bind-Value="Dataset.workflowExecution.Executionoutcome" MultiSelection="false" Class="mt-3"
                                               Label="@languageContainer.Keys["ExecutionOutcome"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                               OpenIcon="@Icons.Material.Filled.Build" AdornmentColor="Color.Secondary" Dense="true" Disabled="@IsEditDisabled()">
                                        @foreach (WorkflowExecutionoutcome item in Enum.GetValues(typeof(WorkflowExecutionoutcome)))
                                        {
                                            <MudSelectItem Value="@item">@languageContainer.Keys[item.ToString()]</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="Dataset.workflowExecution.Note" Lines="5" Margin="Margin.Dense" Disabled="@IsEditDisabled()"
                                              Label="@languageContainer.Keys["StepNote"]" Variant="Variant.Outlined" />
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudCard>

                @* ── Vehicle data card (conditional) ──*@
                @if (Dataset.workflowTask.UserMustUpdateVeichleKm || Dataset.workflowTask.UserMustUpdateFuelLevel)
                {
                    <MudExpansionPanel @bind-Expanded="vehicleCardExpanded" Style="border-radius: 12px; border: 1px solid rgba(0,0,0,0.12);">
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.DirectionsCar" Color="Color.Secondary" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle2">@languageContainer.Keys["VeichleData"]</MudText>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudGrid Spacing="2" Class="pa-2">
                                @if (Dataset.workflowTask.UserMustUpdateVeichleKm)
                                {
                                    <MudItem xs="12" sm="6">
                                        <MudNumericField @bind-Value="Dataset.workflowExecution.KmPost" Min="1" Max="int.MaxValue" Margin="Margin.Dense"
                                                         Label="@languageContainer.Keys["ActualKilometers"]" Variant="Variant.Outlined" Step="1" Disabled="@IsEditDisabled()" />
                                    </MudItem>
                                }
                                @if (Dataset.workflowTask.UserMustUpdateFuelLevel)
                                {
                                    <MudItem xs="12" sm="6">
                                        <MudNumericField @bind-Value="Dataset.workflowExecution.FuelPost" Min="1" Max="100" Margin="Margin.Dense"
                                                         Label="@languageContainer.Keys["ActualFuelPercentage"]" Variant="Variant.Outlined" Step="1" Disabled="@IsEditDisabled()" />
                                    </MudItem>
                                }
                            </MudGrid>
                        </ChildContent>
                    </MudExpansionPanel>
                }

                @* ── Images card (conditional) ──*@
                @if (Dataset.workflowTask.AllowImageUpload)
                {
                    <MudExpansionPanel @bind-Expanded="imagesCardExpanded" Style="border-radius: 12px; border: 1px solid rgba(0,0,0,0.12);">
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Secondary" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle2">@languageContainer.Keys["Images"]</MudText>
                                @if (Dataset.workflowExecution.Images != null && Dataset.workflowExecution.Images.Any())
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@Dataset.workflowExecution.Images.Count()</MudChip>
                                }
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudStack Spacing="2" Class="pa-2">
                                @if (!Dataset.viewOneExecution)
                                {
                                    <MudFileUpload T="IBrowserFile" FilesChanged="UploadImage" Accept=".png, .jpg" Disabled="@IsEditDisabled()">
                                        <ActivatorContent>
                                            <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.AddPhotoAlternate" Disabled="@IsEditDisabled()">
                                                @languageContainer.Keys["LoadPictures"]
                                            </MudButton>
                                        </ActivatorContent>
                                    </MudFileUpload>
                                }
                                @if (Dataset.workflowExecution.Images != null && Dataset.workflowExecution.Images.Any())
                                {
                                    <MudList T="string" Dense="true">
                                        @foreach (var image in Dataset.workflowExecution?.Images ?? new List<Image>())
                                        {
                                            <MudListItem Icon="@Icons.Material.Filled.AttachFile" @key="@image" OnClick="@(() => PreviewImage(image))">
                                                <MudText Style="cursor: pointer; text-decoration: underline;" Color="Color.Info">@image.Name</MudText>
                                            </MudListItem>
                                        }
                                    </MudList>
                                }
                                @if (previewImage != null)
                                {
                                    <MudPaper Elevation="2" Class="pa-2" Style="position: relative; text-align: center;">
                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small"
                                                       Style="position: absolute; top: 4px; right: 4px; z-index: 1;"
                                                       OnClick="@(() => previewImage = null)" />
                                        <MudImage Src="@previewImageUrl" Alt="@previewImage.Name"
                                                  Style="max-width: 100%; max-height: 350px;" ObjectFit="ObjectFit.Contain" Elevation="0" />
                                    </MudPaper>
                                }
                            </MudStack>
                        </ChildContent>
                    </MudExpansionPanel>
                }

                @* ── Components card (conditional) ──*@
                @if (Dataset.workflowTask.IsComponentRequired)
                {
                    <MudExpansionPanel @bind-Expanded="componentsCardExpanded" Style="border-radius: 12px; border: 1px solid rgba(0,0,0,0.12);">
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.SettingsInputComponent" Color="Color.Secondary" Size="Size.Small" />
                                <MudText Typo="Typo.subtitle2">@languageContainer.Keys["Components"]</MudText>
                                @if (Dataset.workflowExecution.Components != null && Dataset.workflowExecution.Components.Any())
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@Dataset.workflowExecution.Components.Count()</MudChip>
                                }
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudStack Spacing="2" Class="pa-2">
                                <MudGrid Spacing="2" Class="align-items-center">
                                    @if (!Dataset.viewOneExecution)
                                    {
                                        <MudItem xs="12" sm="4">
                                            <MudButton OnClick="@((e) => dataGrid.SetEditingItemAsync(selectedComponent))" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Add" Disabled="@IsEditDisabled()">
                                                @languageContainer.Keys["AddNewComponent"]
                                            </MudButton>
                                        </MudItem>
                                    }
                                    <MudItem xs="12" sm="@(Dataset.viewOneExecution ? 12 : 8)">
                                        <MudAutocomplete T="Component" ToStringFunc="component => component?.Name"
                                                         Label="@languageContainer.Keys["Component"]"
                                                         Margin="Margin.Dense" Variant="Variant.Outlined"
                                                         Value="selectedComponent" ValueChanged="@UpdateSelectedComponent"
                                                         SearchFunc="@SearchComponent" DebounceInterval="500" MaxItems="null" FullWidth="true"
                                                         ResetValueOnEmptyText="true" CoerceText="false" CoerceValue="true" Dense="true" Disabled="@IsEditDisabled()" />
                                    </MudItem>
                                </MudGrid>
                                <MudDataGrid @ref="dataGrid" T="Component" Items="@Dataset.workflowExecution.Components" ReadOnly="@IsEditDisabled()" EditMode="DataGridEditMode.Form" EditTrigger="DataGridEditTrigger.Manual"
                                             Filterable="true" Dense="true" Hover="true" SortMode="@SortMode.Single" Bordered="true"
                                             StartedEditingItem="@StartedEditingItem" CanceledEditingItem="@CanceledEditingItem" CommittedItemChanges="@CommittedItemChanges">
                                    <Columns>
                                        <TemplateColumn Hidden="false" CellClass="d-flex justify-center">
                                            <CellTemplate>
                                                <MudIconButton Color="Color.Info" Size="@Size.Medium" Icon="@Icons.Material.Outlined.Edit" OnClick="@(() => dataGrid.SetEditingItemAsync(context.Item))" Disabled="@IsEditDisabled()" Style="@(Dataset.viewOneExecution ? "display:none;" : "")" />
                                                <MudIconButton Color="Color.Error" Size="@Size.Medium" Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => DeleteItem(context.Item))" Disabled="@IsEditDisabled()" Style="@(Dataset.viewOneExecution ? "display:none;" : "")" />
                                            </CellTemplate>
                                        </TemplateColumn>
                                        <PropertyColumn Property="x => x.Barcode" Title="@languageContainer.Keys["Barcode"]" Required="true" Editable="true" Sortable="false" Hidden="false" />
                                        <PropertyColumn Property="x => x.Name" Title="@languageContainer.Keys["Name"]" Required="true" Editable="true" Sortable="false" Hidden="false" />
                                        <PropertyColumn Property="x => x.Quanity" Title="@languageContainer.Keys["Quanity"]" Required="true" Editable="true" Sortable="false" Hidden="false" />
                                        <PropertyColumn Property="x => x.PricePerQuantity" Title="@languageContainer.Keys["PricePerQuantity"]" Required="true" Editable="true" Sortable="false" Hidden="false" />
                                        <PropertyColumn Property="x => x.UnitOfMeasurement" Title="@languageContainer.Keys["UnitOfMeasurement"]" Required="true" Editable="true" Sortable="false" Hidden="false" />
                                    </Columns>
                                    <PagerContent>
                                        <MudDataGridPager T="Component" PageSizeOptions="@Utility.pageSizeOptions" RowsPerPageString="@languageContainer.Keys["RowsPerPageString"]" />
                                    </PagerContent>
                                </MudDataGrid>
                            </MudStack>
                        </ChildContent>
                    </MudExpansionPanel>
                }

            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        @if (!Dataset.viewOneExecution)
        {
            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="w-100 px-1" Wrap="Wrap.Wrap" Spacing="2">
                <MudStack Row="true" Spacing="1">
                    @if (Dataset.editOneExecution == false && Dataset.workflowTask.CanBeSkipped)
                    {
                        <MudButton OnClick="(() => Confirm(WorkflowExecutionStatus.Skipped))"
                                   Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AirlineStops" Color="Color.Warning" Disabled="@IsEditDisabled()">
                            @languageContainer.Keys["ResumeWorkflowSkipStep"]
                        </MudButton>
                    }
                </MudStack>
                <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                    @if (Dataset.workflowExecution.IsCompleted)
                    {
                        <MudButton OnClick="(() => Confirm(WorkflowExecutionStatus.InProgress))"
                                   Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Warning" Disabled="@IsEditDisabled()">
                            @languageContainer.Keys["SaveChanges"]
                        </MudButton>
                    }
                    else
                    {
                        <MudButton OnClick="(() => Confirm(WorkflowExecutionStatus.InProgress))"
                                   Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" Color="Color.Primary" Disabled="@IsEditDisabled()">
                            @languageContainer.Keys["ResumeWorkflowSaveStep"]
                        </MudButton>
                        <MudButton OnClick="(() => MarkAsCompleted())"
                                   Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Check" Color="Color.Success" Disabled="@IsEditDisabled()">
                            @languageContainer.Keys["StepComplete"]
                        </MudButton>
                    }
                </MudStack>
            </MudStack>
        }
    </DialogActions>
</MudDialog>



@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter]
    public ResumeWorkflowDialogParameter Dataset { get; set; } = new ResumeWorkflowDialogParameter();
    public MudDataGrid<Component> dataGrid { get; set; } = null!;
    private DialogOptions dialogOptions = new() { BackdropClick = false };
    private Component selectedComponent = new Component();

    private bool processing = false;
    private Image? previewImage = null;
    private string? previewImageUrl = null;

    // Expansion panels state
    private bool vehicleCardExpanded = true;
    private bool imagesCardExpanded = true;
    private bool componentsCardExpanded = true;

    // Time tracking
    private TimeTracking? currentTimeTracking = null;
    private bool isTrackingActive = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadTimeTrackingState();
    }

    private async Task LoadTimeTrackingState()
    {
        if (Dataset.viewOneExecution) return;

        var seriesId = Dataset.workflowExecution.WorkflowExecutionSeriesId;
        var employeeId = Dataset.employee.Id;

        if (string.IsNullOrEmpty(seriesId) || string.IsNullOrEmpty(employeeId)) return;

        var trackings = await dbDependency.GetDataAccessTimeTracking().FindAsync(
            new SearcherTimeTracking { EmployeeId = employeeId, WorkflowExecutionSeriesId = seriesId });
        currentTimeTracking = trackings.FirstOrDefault();

        if (currentTimeTracking != null && currentTimeTracking.IsActive)
        {
            isTrackingActive = true;
        }
    }

    private bool IsEditDisabled()
    {
        if (Dataset.viewOneExecution) return true;
        return !isTrackingActive;
    }

    private async Task PreviewImage(Image image)
    {
        if (previewImage == image)
        {
            previewImage = null;
            previewImageUrl = null;
            return;
        }
        previewImage = image;
        if (File.Exists(image.Path))
        {
            var bytes = await File.ReadAllBytesAsync(image.Path);
            previewImageUrl = $"data:{image.ContentType};base64,{Convert.ToBase64String(bytes)}";
        }
        else
        {
            previewImageUrl = null;
        }
    }

    private async Task MarkAsCompleted()
    {
        Dataset.workflowExecution.IsCompleted = true;
        await Confirm(WorkflowExecutionStatus.InProgress);
    }

    private async Task Confirm(WorkflowExecutionStatus executionStatus, bool repeat = false)
    {
        try{
            processing = true;        

            if (!IsDataValid(executionStatus)) //Valido i dati solo se non skippo
                return;

            if (executionStatus == WorkflowExecutionStatus.Closed)
            {
                bool? result = await dialogService.ShowMessageBox(
                                  languageContainer.Keys["ResumeWorkflowGotoNextStepTitle"],
                                  languageContainer.Keys["ResumeWorkflowGotoNextStepDescription"],
                                  yesText: @languageContainer.Keys["Yes"], cancelText: @languageContainer.Keys["No"]);
                var confirmed = result == null ? false : true;
                if (!confirmed)
                    return;
            }

            var nextTask = await GetNextStep(executionStatus, repeat);
            await InsertStepData(executionStatus);
            await UpdateVeichle(nextTask, executionStatus, repeat);

            if (executionStatus == WorkflowExecutionStatus.Closed || executionStatus == WorkflowExecutionStatus.Skipped)
            {           
                await GoToNextStep(nextTask, repeat);

                if (executionStatus == WorkflowExecutionStatus.Skipped)
                    snackbar.Add(languageContainer.Keys["ResumeWorkflowGotoNextStepSkpipped"], Severity.Warning);
                else
                {
                    var message = languageContainer.Keys["ResumeWorkflowGotoNextStepSaved"];
                    if (!nextTask.IsFinalTask)
                        if (repeat)
                            message = $"{message} {languageContainer.Keys["ResumeWorkflowGotoNextStepCompletedRepeat"]}: {nextTask.Title}";                           
                        else
                            message = $"{message} {languageContainer.Keys["ResumeWorkflowGotoNextStepCompleted"]}: {nextTask.Title}";

                    snackbar.Add(message, Severity.Success);
                }

                if (String.IsNullOrEmpty(nextTask.Id))
                {
                    snackbar.Add(languageContainer.Keys["ResumeWorkflowCompleted"], Severity.Info);
                }

            }
            else if (executionStatus == WorkflowExecutionStatus.InProgress)
            {
                snackbar.Add(languageContainer.Keys["ResumeWorkflowGotoNextStepSaved"], Severity.Info);
            }

        }catch(Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            processing = false;
        }
    }

    private void Cancel()
    {        
        MudDialog.Cancel();
    }

    private async Task UploadImage(IBrowserFile file)
    {
        try
        {
            processing = true;

            if (Dataset.workflowExecution.Images == null)
                Dataset.workflowExecution.Images = new List<Image>();

            var img = new Image
            {
                Id = Guid.NewGuid().ToString(),
                Name = file.Name,
                ContentType = file.ContentType,
                Size = file.Size,                
                LastModified = file.LastModified.UtcDateTime,               
            };
            img.Path = Utility.GetImagePath(img.Id, Dataset.workflowExecution.WorkflowExecutionSeriesId, img.Name);

            using (var stream = new MemoryStream())
            {        
                await file.OpenReadStream(file.Size).CopyToAsync(stream);
                byte[] imageBytes = stream.ToArray();
                await File.WriteAllBytesAsync(img.Path, imageBytes);
            }                 

            Dataset.workflowExecution.Images.Add(img); //Aggiungo le nuove caricate

        }catch(Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            processing = false;
        }

    }

    private bool IsDataValid(WorkflowExecutionStatus workflowExecutionStatus)
    {
        bool isValid = true;

        if (workflowExecutionStatus == WorkflowExecutionStatus.Skipped)
            return true;

        Dataset.workflowExecution.Titile = Dataset.workflowExecution.Titile?.Trim();
        Dataset.workflowExecution.Note = Dataset.workflowExecution.Note?.Trim();

        if (String.IsNullOrEmpty(Dataset.workflowExecution.Titile))
        {
            snackbar.Add(@languageContainer.Keys["StepTitleError"], Severity.Warning);
            isValid = false;
        }
        if (Dataset.workflowTask.UserMustUpdateVeichleKm && Dataset.workflowExecution.KmPost == null)
        {
            snackbar.Add(@languageContainer.Keys["StepVeichleKmError"], Severity.Warning);
            isValid = false;
        }
        if (Dataset.workflowTask.UserMustUpdateFuelLevel && Dataset.workflowExecution.FuelPost == null)
        {
            snackbar.Add(@languageContainer.Keys["StepVeichleFuelError"], Severity.Warning);
            isValid = false;
        }
        // if (Dataset.workflowTask.AllowImageUpload && Dataset.workflowExecution.Images?.Count() == 0)
        // {
        //     snackbar.Add(@languageContainer.Keys["StepImageError"], Severity.Warning);
        //     isValid = false;
        // }
        // if (Dataset.workflowTask.IsComponentRequired && Dataset.workflowExecution?.Components?.Count() == 0)
        // {
        //     snackbar.Add(@languageContainer.Keys["StepComponentError"], Severity.Warning);
        //     isValid = false;
        // }

        return isValid;
    }

    private async Task InsertStepData(WorkflowExecutionStatus executionStatus)
    {
        if (executionStatus == WorkflowExecutionStatus.Skipped) //Resetto i dati non salvo niente a parte il fatto che è stato skippato
        {            
            Dataset.workflowExecution.Titile = String.Empty;
            Dataset.workflowExecution.Note = String.Empty;
            Dataset.workflowExecution.KmPost = null;
            Dataset.workflowExecution.KmPre = null;
            Dataset.workflowExecution.FuelPost = null;
            Dataset.workflowExecution.FuelPre = null;
            Dataset.workflowExecution.Images = null;
            Dataset.workflowExecution.Components = null;
        }    

        bool isNew = Dataset.isNewExecution;
        Dataset.isNewExecution = false;

        Dataset.workflowExecution.EmployeeId = Dataset.employee.Id;
        Dataset.workflowExecution.UserId = Dataset.customer.Id;
        Dataset.workflowExecution.VeichleId = Dataset.veichle.Id;
        Dataset.workflowExecution.WorkflowId = Dataset.workflow.Id;
        if (!isNew)
        {
            var currentEntry = Dataset.veichle?.OpenWorkflows?.FirstOrDefault(w => w.WorkflowId == Dataset.workflow.Id);
            Dataset.workflowExecution.WorkflowTaskId = currentEntry?.WorkflowTaskId ?? "";
        }
        Dataset.workflowExecution.FuelPre = Dataset.veichle?.ActualFuelPercentage;
        Dataset.workflowExecution.KmPre = Dataset.veichle?.ActualKilometers;
        Dataset.workflowExecution.ExecutionStatus = executionStatus;

        if (executionStatus == WorkflowExecutionStatus.Closed)
            Dataset.workflowExecution.ClosedAt = DateTime.Now;

        if (Dataset.workflowExecution.IsCompleted)
            Dataset.workflowExecution.ClosedAt ??= DateTime.Now;

        if (isNew)
        {
            Dataset.workflowExecution.OpenAt = DateTime.Now;
            await dbDependency.GetDataAccessWorkflowExecution().InsertAsync(Dataset.workflowExecution);
        }
        else
            await dbDependency.GetDataAccessWorkflowExecution().UpdateAsync(Dataset.workflowExecution);
    }

    private async Task UpdateVeichle(WorkflowTask nextTask, WorkflowExecutionStatus executionStatus, bool repeat)
    {
        if (executionStatus == WorkflowExecutionStatus.Skipped) //Non facio niente
            return;

        var veichle = Dataset.veichle;        

        if(executionStatus == WorkflowExecutionStatus.Closed) //Aggiorno gli step solo in caso di chiusura del task
        {
            if (Dataset.workflowTask.UserMustUpdateVeichleKm)
                veichle.ActualKilometers = Dataset.workflowExecution.KmPost;
            if (Dataset.workflowTask.UserMustUpdateFuelLevel)
                veichle.ActualFuelPercentage = Dataset.workflowExecution.FuelPost;

            var entry = veichle.OpenWorkflows?.FirstOrDefault(w => w.WorkflowId == Dataset.workflow.Id);
            if (entry != null && !String.IsNullOrEmpty(nextTask.Id))
            {
                entry.WorkflowTaskId = repeat ? entry.WorkflowTaskId : nextTask.Id;
            }
        }

        veichle.UpdateDate = DateTime.Now;
        await dbDependency.GetDataAccessVeichle().UpdateAsync(veichle);
    }

    private async Task GoToNextStep(WorkflowTask nextTask, bool repeat)
    {
        if (String.IsNullOrEmpty(nextTask.Id)) //Ho finito
            return;

        var workflowExecutionSeriesId = Dataset.workflowExecution.WorkflowExecutionSeriesId;

        //Setto i campi per il prossimo step
        Dataset.workflowTask = nextTask;

        // Find the existing execution for the next task (already created at workflow start)
        var existingExecutions = await dbDependency.GetDataAccessWorkflowExecution().FindAsync(
            new SearcherWorkflowExecution { WorkflowExecutionSeriesId = workflowExecutionSeriesId });
        var nextExecution = existingExecutions
            .FirstOrDefault(e => e.WorkflowTaskId == nextTask.Id && e.ExecutionStatus == WorkflowExecutionStatus.Todo);

        if (nextExecution != null)
        {
            Dataset.workflowExecution = nextExecution;

            // Update vehicle entry to point to this execution
            var nextEntry = Dataset.veichle.OpenWorkflows?.FirstOrDefault(w => w.WorkflowId == Dataset.workflow.Id);
            if (nextEntry != null)
                nextEntry.WorkflowExecutionId = nextExecution.Id;
        }
        else
        {
            // Fallback: create a new execution if not found (e.g. repeat scenario)
            Dataset.workflowExecution = new WorkflowExecution();
            Dataset.workflowExecution.Id = Guid.NewGuid().ToString();
            Dataset.workflowExecution.EmployeeId = Dataset.employee.Id;
            Dataset.workflowExecution.UserId = Dataset.customer.Id;
            Dataset.workflowExecution.VeichleId = Dataset.veichle.Id;
            Dataset.workflowExecution.WorkflowId = Dataset.workflow.Id;
            Dataset.workflowExecution.WorkflowTaskId = nextTask.Id;
            Dataset.workflowExecution.WorkflowExecutionSeriesId = workflowExecutionSeriesId;
            Dataset.workflowExecution.ExecutionStatus = WorkflowExecutionStatus.Todo;
            Dataset.workflowExecution.OpenAt = DateTime.Now;
            Dataset.workflowExecution.Titile = $"{nextTask.Title} - {nextTask.Subtitle}";

            var nextWf = await dbDependency.GetDataAccessWorkflowTask().FindByIdAsync(nextTask.Id);
            if (nextWf != null)
            {
                if (nextWf.UserMustUpdateVeichleKm)
                    Dataset.workflowExecution.KmPost = Dataset.veichle.ActualKilometers;
                if (nextWf.UserMustUpdateFuelLevel)
                    Dataset.workflowExecution.FuelPost = Dataset.veichle.ActualFuelPercentage;
            }

            await dbDependency.GetDataAccessWorkflowExecution().InsertAsync(Dataset.workflowExecution);
        }
    }

    private async Task<WorkflowTask> GetNextStep(WorkflowExecutionStatus executionStatus, bool repeat)
    {
        if (executionStatus != WorkflowExecutionStatus.Closed && executionStatus != WorkflowExecutionStatus.Skipped) //Faccio le querty solo se servono
            return new WorkflowTask();

        if (repeat)
            return Dataset.workflowTask;

        //In caso di ultimo task pulisco anche tuti i dati
        if (Dataset.workflowTask.IsFinalTask)
            return new WorkflowTask();

        var steps = await dbDependency.GetDataAccessWorkflowTask().FindAsync(new SearcherWorkflowTask()
        {
             WorkflowId = Dataset.workflow.Id
        });

        steps = steps.Where(x => !x.Id.Equals(Dataset.workflowTask.Id)).Where(x => x.TaskOrder >= Dataset.workflowTask.TaskOrder).OrderBy(x => x.TaskOrder).ToList();

        return steps.FirstOrDefault() ?? new WorkflowTask();
    }

