    private async Task ImportWorkflowTasksAsync(IBrowserFile? file)
    {
        if (file == null) return;
        processing = true;
        StateHasChanged();
        try
        {
            List<Dictionary<string, string>> rows;
            try { rows = await ImportExportHelper.ParseCsvAsync(file, WorkflowTaskHeaders); }
            catch { snackbar.Add(languageContainer.Keys["ImportInvalidFile"], Severity.Error); return; }

            if (rows.Count == 0) { snackbar.Add(languageContainer.Keys["ImportNoData"], Severity.Warning); return; }

            var allTasksTask     = dbDependency.GetDataAccessWorkflowTask().FindAsync(new SearcherWorkflowTask());
            var allWorkflowsTask = dbDependency.GetDataAccessWorkflow().FindAsync(new SearcherWorkflow());
            await Task.WhenAll(allTasksTask, allWorkflowsTask);

            var allTasks     = allTasksTask.Result;
            var allWorkflows = allWorkflowsTask.Result;

            var workflowByTitle = allWorkflows
                .Where(w => !string.IsNullOrWhiteSpace(w.Title))
                .ToDictionary(w => w.Title.Trim().ToLowerInvariant());

            // composite key: workflowId + taskOrder
            var taskByKey = allTasks
                .ToDictionary(t => $"{t.WorkflowId}|{t.TaskOrder}");

            var previews = new ImportRowPreview[rows.Count];
            var objects  = new (WorkflowTask? Obj, bool Valid)[rows.Count];
            var warnings = new System.Collections.Concurrent.ConcurrentBag<string>();

            Parallel.For(0, rows.Count, i =>
            {
                var row        = rows[i];
                var titleKey   = row.GetOr("WorkflowTitle").Trim().ToLowerInvariant();
                var taskOrder  = row.GetOr("TaskOrder").Trim();

                if (string.IsNullOrWhiteSpace(titleKey) || string.IsNullOrWhiteSpace(taskOrder))
                {
                    objects[i] = (null, false);
                    return;
                }

                if (!workflowByTitle.TryGetValue(titleKey, out var workflow))
                {
                    warnings.Add(string.Format(languageContainer.Keys["ImportWorkflowTaskWorkflowNotFound"], i + 1));
                    objects[i] = (null, false);
                    return;
                }

                var compositeKey = $"{workflow.Id}|{taskOrder}";
                taskByKey.TryGetValue(compositeKey, out var match);

                var obj = ImportExportHelper.MapWorkflowTask(row, match, workflow.Id);
                objects[i]  = (obj, true);
                previews[i] = new ImportRowPreview
                {
                    RowNumber  = i + 1,
                    MatchType  = match == null ? ImportMatchType.Insert : ImportMatchType.Update,
                    ExistingId = match?.Id,
                    Cells      = ImportExportHelper.WorkflowTaskToCells(obj, row.GetOr("WorkflowTitle"))
                };
            });

            foreach (var w in warnings) snackbar.Add(w, Severity.Warning);

            var validPreviews = previews.Where((p, i) => objects[i].Valid).ToList();
            if (validPreviews.Count == 0) { snackbar.Add(languageContainer.Keys["ImportNoData"], Severity.Warning); return; }

            var params_ = new DialogParameters<ImportPreviewDialog>
            {
                { x => x.Rows,    validPreviews },
                { x => x.Headers, WorkflowTaskHeaders }
            };
            var dialog = await dialogService.ShowAsync<ImportPreviewDialog>(
                languageContainer.Keys["ImportPreviewTitle"],
                params_,
                new DialogOptions { MaxWidth = MaxWidth.ExtraExtraLarge, FullWidth = true, CloseOnEscapeKey = true });

            var result = await dialog.Result;
            if (result == null || result.Canceled) return;

            int inserted = 0, updated = 0;
            var tasks = objects.Select(async (entry, i) =>
            {
                if (!entry.Valid || entry.Obj == null) return;
                var p = previews[i];
                if (p.MatchType == ImportMatchType.Update)
                {
                    entry.Obj.Id = p.ExistingId!;
                    await dbDependency.GetDataAccessWorkflowTask().UpdateAsync(entry.Obj);
                    System.Threading.Interlocked.Increment(ref updated);
                }
                else
                {
                    entry.Obj.Id = Guid.NewGuid().ToString();
                    await dbDependency.GetDataAccessWorkflowTask().InsertAsync(entry.Obj);
                    System.Threading.Interlocked.Increment(ref inserted);
                }
            });

            await Task.WhenAll(tasks);
            snackbar.Add(string.Format(languageContainer.Keys["ImportSuccess"], inserted, updated), Severity.Success);
        }
        catch (Exception ex) { snackbar.Add(ex.Message, Severity.Error); }
        finally { processing = false; StateHasChanged(); }
    }
