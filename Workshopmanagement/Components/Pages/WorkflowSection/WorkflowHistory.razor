@page "/workflowshistory"

@inject IJSRuntime JSRuntime
@inject IDbDependency dbDependency
@inject ISnackbar snackbar
@inject IDialogService dialogService
@inject ILanguageContainerService languageContainer
@inject ProtectedLocalStorage protectedLocalStorage
@inject NavigationManager navigationManager
@inject IAppLogger appLogger

<MudContainer Class="loading-overlay" Style="@(processing ? "display:flex;" : "display:none;")">
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
</MudContainer>

<MudGrid>
    <MudItem xs="12">
        <MudGrid>
            <MudItem xs="4">
                <MudAutocomplete T="Customer" ToStringFunc="customer => GetCustomersFromList(customer?.Id)"
                                 Label="@languageContainer.Keys["Customer"]" Margin="Margin.Dense"
                                 Value="selectedCustomer" ValueChanged="@UpdateSelectedCustomer"
                                 SearchFunc="@SearchCustomer" DebounceInterval="500" MaxItems="null"
                                 ResetValueOnEmptyText="true" CoerceText="false" CoerceValue="true" />
            </MudItem>
            <MudItem xs="4">
                <MudSelect T="Veichle" Value="selectedVeichle" ValueChanged="UpdateSelectedVeichle"
                           ToStringFunc="veichle => Utility.GetDescriptionFromVeichle(veichle, languageContainer)"
                           Label="@languageContainer.Keys["Veichle"]"
                           CloseIcon="@Icons.Material.Filled.AirportShuttle" AdornmentColor="Color.Info">
                    @foreach (var veichle in veichles)
                    {
                        <MudSelectItem T="Veichle" Value="veichle">
                            @Utility.GetDescriptionFromVeichle(veichle, languageContainer)
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudItem>
    <MudItem xs="12">
        <MudDataGrid @ref="dataGrid" T="HistoryWorkflowView" Items="@gridItems" ReadOnly="true"
                     Filterable="true" Dense="false" Hover="true" SortMode="@SortMode.Single" Bordered="true">
            <ToolBarContent>
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Filled.History" Style="margin-right: 6px;" />
                    @languageContainer.Keys["ExecutionHistory"]
                </MudText>
                <MudSpacer />
            </ToolBarContent>
            <Columns>
                <TemplateColumn Title="" Sortable="false" HeaderStyle="width: 120px;">
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Justify="Justify.Center">
                            @if (employee?.EmployeeRole == EmployeeRole.Manager)
                            {
                                <MudButton OnClick="@(() => ReopenWorkflowAsync(context.Item))"
                                           Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Replay">
                                    @languageContainer.Keys["ReopenWorkflow"]
                                </MudButton>
                            }
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="" Sortable="false" HeaderStyle="width: 50px;">
                    <CellTemplate>
                        <MudIconButton OnClick="@(() => ViewReportAsync(context.Item))"
                                       Icon="@Icons.Material.Outlined.PictureAsPdf"
                                       Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small" />
                    </CellTemplate>
                </TemplateColumn>
                <HierarchyColumn T="HistoryWorkflowView" />
                <TemplateColumn Title="@languageContainer.Keys["ExecutionTitle"]" Sortable="false">
                    <CellTemplate>
                        @{
                            var wfInfo = GetWorkflowInfoFull(context.Item.WorkflowId);
                        }
                        <MudChip T="string" Style="@($"background-color:{wfInfo.color}; color:white;")" Size="Size.Small">@wfInfo.title</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@languageContainer.Keys["ExecutionSubtitle"]" Sortable="false">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">@($"{context.Item.Veichle.LicensePlate} - {context.Item.Veichle.Model}")</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@languageContainer.Keys["OpenAt"]" Sortable="true"
                                SortBy="@(x => GetSeriesOpenDate(x.WorkflowExecutionSeriesId) ?? DateTime.MinValue)">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">
                            @Utility.GetDateFormatted(GetSeriesOpenDate(context.Item.WorkflowExecutionSeriesId), Utility.DateFormat.FullDate)
                        </MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@languageContainer.Keys["ClosedAt"]" Sortable="true"
                                SortBy="@(x => GetSeriesCloseDate(x.WorkflowExecutionSeriesId) ?? DateTime.MinValue)">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">
                            @Utility.GetDateFormatted(GetSeriesCloseDate(context.Item.WorkflowExecutionSeriesId), Utility.DateFormat.FullDate)
                        </MudText>
                    </CellTemplate>
                </TemplateColumn>                <TemplateColumn Title="@languageContainer.Keys["TimeTrackingHoursSpent"]" Sortable="false">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">@GetTrackingTime(context.Item.WorkflowExecutionSeriesId)</MudText>
                    </CellTemplate>
                </TemplateColumn>            </Columns>

            <ChildRowContent>
                <td colspan="100" style="padding: 0;">
                    <MudCard Outlined="true" Elevation="0" Class="ma-3">
                        <MudCardContent Style="padding: 8px;">
                            <MudSimpleTable Dense="true" Hover="true" Bordered="true" Striped="true"
                                           Style="background-color: transparent; width: 100%;">
                                <thead>
                                    <tr>
                                        <th style="width: 60px;"></th>
                                        <th style="width: 60px; text-align: center;">@languageContainer.Keys["StepCompleted"]</th>
                                        <th>@languageContainer.Keys["StepTitleHistory"]</th>
                                        <th>@languageContainer.Keys["StepTitleExHistory"]</th>
                                        <th style="width: 60px; text-align: center;">@languageContainer.Keys["StepTitleStatus"]</th>
                                        <th style="width: 60px; text-align: center;">@languageContainer.Keys["StepTitleOutcome"]</th>
                                        <th>@languageContainer.Keys["OpenAt"]</th>
                                        <th>@languageContainer.Keys["ClosedAt"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var step in GetStepsForSeries(context.Item))
                                    {
                                        if (step.Task.TaskOrder < 0)
                                            continue;
                                        <tr>
                                            <td>
                                                @if (step.Execution != null)
                                                {
                                                    <MudIconButton OnClick="@(() => ViewStepAsync(context.Item, step))"
                                                                   Color="Color.Info" Size="@Size.Small"
                                                                   Icon="@Icons.Material.Filled.RemoveRedEye"
                                                                   Variant="Variant.Outlined" />
                                                }
                                            </td>
                                            <td style="text-align: center;">
                                                @if (step.Execution != null && step.Execution.IsCompleted)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                                }
                                            </td>
                                            <td>@Utility.TruncateFroHtml(step.Task.Title, 40)</td>
                                            <td>@(step.Execution != null ? Utility.TruncateFroHtml(step.Execution.Titile, 40) : "-")</td>
                                            <td style="text-align: center;">
                                                @if (step.Execution != null)
                                                {
                                                    @if (step.Execution.ExecutionStatus == WorkflowExecutionStatus.InProgress)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled._360" Color="Color.Info" Size="Size.Small" />
                                                    }
                                                    else if (step.Execution.ExecutionStatus == WorkflowExecutionStatus.Todo)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.AssignmentReturned" Color="Color.Default" Size="Size.Small" />
                                                    }
                                                    else if (step.Execution.ExecutionStatus == WorkflowExecutionStatus.Skipped)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.AirlineStops" Color="Color.Warning" Size="Size.Small" />
                                                    }
                                                    else if (step.Execution.ExecutionStatus == WorkflowExecutionStatus.Closed)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Color="Color.Success" Size="Size.Small" />
                                                    }
                                                }
                                                else
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Default" Size="Size.Small" />
                                                }
                                            </td>
                                            <td style="text-align: center;">
                                                @if (step.Execution != null)
                                                {
                                                    @if (step.Execution.Executionoutcome == WorkflowExecutionoutcome.RunningOut)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.GasMeter" Color="Color.Warning" Size="Size.Small" />
                                                    }
                                                    else if (step.Execution.Executionoutcome == WorkflowExecutionoutcome.ToBeReplaced)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.Build" Color="Color.Warning" Size="Size.Small" />
                                                    }
                                                    else if (step.Execution.Executionoutcome == WorkflowExecutionoutcome.ToBeVerified)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.Engineering" Color="Color.Warning" Size="Size.Small" />
                                                    }
                                                    else if (step.Execution.Executionoutcome == WorkflowExecutionoutcome.Replaced)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.ThumbUp" Color="Color.Success" Size="Size.Small" />
                                                    }
                                                    else if (step.Execution.Executionoutcome == WorkflowExecutionoutcome.Verified)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.Done" Color="Color.Success" Size="Size.Small" />
                                                    }
                                                    else if (step.Execution.Executionoutcome == WorkflowExecutionoutcome.Ok)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.DoneAll" Color="Color.Success" Size="Size.Small" />
                                                    }
                                                }
                                            </td>
                                            <td>@(step.Execution != null ? Utility.GetDateFormatted(step.Execution.OpenAt, Utility.DateFormat.FullDate) : "")</td>
                                            <td>@(step.Execution != null ? Utility.GetDateFormatted(step.Execution.ClosedAt, Utility.DateFormat.FullDate) : "")</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudCardContent>
                    </MudCard>
                </td>
            </ChildRowContent>

            <PagerContent>
                <MudDataGridPager T="HistoryWorkflowView" PageSizeOptions="@Utility.pageSizeOptions"
                                  RowsPerPageString="@languageContainer.Keys["RowsPerPageString"]" />
            </PagerContent>
        </MudDataGrid>
    </MudItem>
</MudGrid>

@code {
    private Employee? employee;
    private Customer selectedCustomer = new Customer();
    private Veichle selectedVeichle = new Veichle();
    private List<Customer> customers = new List<Customer>();
    private List<Veichle> veichles = new List<Veichle>();
    private List<Workflow> workflows = new List<Workflow>();
    private List<WorkflowTask> workflowTasks = new List<WorkflowTask>();
    private List<WorkflowExecution> workflowExecutions = new List<WorkflowExecution>();
    private List<HistoryWorkflowView> gridItems = new List<HistoryWorkflowView>();
    private MudDataGrid<HistoryWorkflowView> dataGrid { get; set; } = null!;
    private Dictionary<string, TimeTracking> trackingsBySeriesId = new Dictionary<string, TimeTracking>();

    private DialogOptions dialogOptions = new DialogOptions
    {
        FullScreen = true,
        CloseButton = true,
        CloseOnEscapeKey = true
    };

    private bool processing = true;

    private class HistoryWorkflowView
    {
        public Veichle Veichle { get; set; } = null!;
        public string WorkflowExecutionSeriesId { get; set; } = null!;
        public string WorkflowId { get; set; } = null!;
    }

    private class WorkflowStepView
    {
        public WorkflowTask Task { get; set; } = new WorkflowTask();
        public WorkflowExecution? Execution { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                processing = true;
                var isUserLogged = await Utility.IsUserLoggedInAsync(protectedLocalStorage);
                if (!isUserLogged)
                {
                    snackbar.Add(@languageContainer.Keys["LoginExpiredError"], Severity.Warning);
                    navigationManager.NavigateTo($"login");
                }
                employee = await Utility.GetCurrentLoggedEmployee(protectedLocalStorage);

                await GetCustomers();
                selectedCustomer = customers?.FirstOrDefault() ?? new Customer();
                await GetVeichle();
                await UpdateSelectedVeichle(veichles?.FirstOrDefault() ?? new Veichle());
            }
        }
        catch (Exception ex)
        {
            if (!ex.Message.Contains("was not found in the key ring. For more information go to https://aka.ms/aspnet/dataprotectionwarning"))
                snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            if (processing)
            {
                processing = false;
                StateHasChanged();
            }
        }
    }

    #region Get data
    private async Task GetCustomers()
    {
        customers = await dbDependency.GetDataAccessCustomer().FindAsync(new SearcherCustomer()
            {
                IsActive = true
            });
        selectedCustomer = customers.FirstOrDefault() ?? new Customer();
    }

    private async Task GetVeichle()
    {
        veichles = await dbDependency.GetDataAccessVeichle().FindAsync(new SearcherVeichle()
            {
                UserId = selectedCustomer?.Id
            });
    }

    private async Task GetWorkflowExecutions()
    {
        workflowExecutions = new List<WorkflowExecution>();
        foreach (var completedSeries in selectedVeichle.WorkflowExecutionsCompleted ?? new List<string>())
        {
            workflowExecutions.AddRange(await dbDependency.GetDataAccessWorkflowExecution().FindAsync(new SearcherWorkflowExecution()
                {
                    UserId = selectedCustomer.Id,
                    VeichleId = selectedVeichle.Id,
                    WorkflowExecutionSeriesId = completedSeries
                }));
        }
    }

    private async Task GetWorkflows()
    {
        workflows = await dbDependency.GetDataAccessWorkflow().FindAsync(new SearcherWorkflow());
    }

    private async Task GetWorkflowTasks()
    {
        workflowTasks = (await dbDependency.GetDataAccessWorkflowTask().FindAsync(new SearcherWorkflowTask())).ToList();
    }
    #endregion

    #region Grid items
    private void RefreshGridItems()
    {
        var series = selectedVeichle.WorkflowExecutionsCompleted ?? new List<string>();

        var newItems = series
            .Select(seriesId =>
            {
                var existing = gridItems.FirstOrDefault(g => g.WorkflowExecutionSeriesId == seriesId);
                if (existing != null)
                {
                    existing.Veichle = selectedVeichle;
                    return existing;
                }

                var workflowId = workflowExecutions
                    .Where(e => e.WorkflowExecutionSeriesId == seriesId && !string.IsNullOrEmpty(e.WorkflowId))
                    .Select(e => e.WorkflowId)
                    .FirstOrDefault() ?? "";

                return new HistoryWorkflowView
                {
                    Veichle = selectedVeichle,
                    WorkflowExecutionSeriesId = seriesId,
                    WorkflowId = workflowId
                };
            })
            .OrderByDescending(x => GetSeriesOpenDate(x.WorkflowExecutionSeriesId) ?? DateTime.MinValue)
            .ToList();

        gridItems = newItems;
    }
    #endregion

    #region Customer selection
    private async Task<IEnumerable<Customer>> SearchCustomer(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
            return customers;
        return customers.Where(x => x.Name.Contains(value, StringComparison.InvariantCultureIgnoreCase)
                                    || x.Surname.Contains(value, StringComparison.InvariantCultureIgnoreCase)
                                    || (x.BusinessName?.Contains(value, StringComparison.InvariantCultureIgnoreCase) ?? false)
                                    || (x.FiscalCode?.Contains(value, StringComparison.InvariantCultureIgnoreCase) ?? false)
                                    || (x.VatNumber?.Contains(value, StringComparison.InvariantCultureIgnoreCase) ?? false));
    }

    private string GetCustomersFromList(string? userId)
    {
        if (string.IsNullOrEmpty(userId))
            return "";
        var customer = customers.FirstOrDefault(x => x.Id.Equals(userId));
        return Utility.GetDescriptionFromCustomer(customer, languageContainer);
    }

    private async Task UpdateSelectedCustomer(Customer customer)
    {
        try
        {
            if (customer == null)
                customer = customers?.FirstOrDefault() ?? new Customer();

            selectedCustomer = customer;
            veichles = new List<Veichle>();
            workflows = new List<Workflow>();
            workflowTasks = new List<WorkflowTask>();
            workflowExecutions = new List<WorkflowExecution>();
            gridItems = new List<HistoryWorkflowView>();
            selectedVeichle = new Veichle();

            await GetVeichle();
        }
        catch (Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
        }
    }
    #endregion

    #region Vehicle selection
    private async Task UpdateSelectedVeichle(Veichle veichle)
    {
        try
        {
            if (veichle == null)
                veichle = new Veichle();
            selectedVeichle = veichle;
            workflows = new List<Workflow>();
            workflowTasks = new List<WorkflowTask>();
            workflowExecutions = new List<WorkflowExecution>();
            gridItems = new List<HistoryWorkflowView>();

            if (string.IsNullOrEmpty(veichle.Id))
                return;

            await Task.WhenAll(GetWorkflowExecutions(), GetWorkflows(), GetWorkflowTasks());
            RefreshGridItems();
            await LoadTimeTrackingStates();
        }
        catch (Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
        }
    }
    #endregion

    #region TimeTracking
    private async Task LoadTimeTrackingStates()
    {
        if (employee == null) return;
        trackingsBySeriesId.Clear();
        var allTrackings = await dbDependency.GetDataAccessTimeTracking().FindAsync(
            new SearcherTimeTracking { EmployeeId = employee.Id });
        foreach (var t in allTrackings)
            trackingsBySeriesId[t.WorkflowExecutionSeriesId] = t;
    }

    private string GetTrackingTime(string seriesId)
    {
        if (string.IsNullOrEmpty(seriesId)) return "00:00:00";
        if (!trackingsBySeriesId.TryGetValue(seriesId, out var t)) return "00:00:00";
        var total = TimeSpan.FromTicks(t.Sessions
            .Where(s => s.EndTime.HasValue)
            .Sum(s => (s.EndTime!.Value - s.StartTime).Ticks));
        return $"{(int)total.TotalHours:D2}:{total.Minutes:D2}:{total.Seconds:D2}";
    }
    #endregion

    #region Table helpers
    private DateTime? GetSeriesOpenDate(string seriesId)
    {
        try
        {
            var execs = workflowExecutions.Where(e => e.WorkflowExecutionSeriesId == seriesId).ToList();
            if (!execs.Any()) return null;
            return execs.Min(e => e.OpenAt);
        }
        catch { return null; }
    }

    private DateTime? GetSeriesCloseDate(string seriesId)
    {
        try
        {
            var execs = workflowExecutions.Where(e => e.WorkflowExecutionSeriesId == seriesId).ToList();
            if (!execs.Any()) return null;
            return execs.Max(e => e.ClosedAt);
        }
        catch { return null; }
    }

    private (string title, string color) GetWorkflowInfoFull(string? workflowId)
    {
        if (string.IsNullOrEmpty(workflowId))
            return ("", "#607D8B");
        var item = workflows.FirstOrDefault(x => x.Id.Equals(workflowId));
        if (item == null)
            return ("", "#607D8B");
        return (item.Title, string.IsNullOrEmpty(item.Color) ? "#607D8B" : item.Color);
    }

    private List<WorkflowStepView> GetStepsForSeries(HistoryWorkflowView item)
    {
        var result = new List<WorkflowStepView>();

        var tasksForWorkflow = workflowTasks
            .Where(t => t.WorkflowId == item.WorkflowId)
            .OrderBy(t => t.TaskOrder)
            .ToList();

        var executionsForSeries = workflowExecutions
            .Where(e => e.WorkflowExecutionSeriesId == item.WorkflowExecutionSeriesId)
            .ToList();

        var usedExecutionIds = new HashSet<string>();

        foreach (var task in tasksForWorkflow)
        {
            var taskExecutions = executionsForSeries
                .Where(e => e.WorkflowTaskId == task.Id && !usedExecutionIds.Contains(e.Id))
                .OrderBy(e => e.OpenAt)
                .ToList();

            if (taskExecutions.Any())
            {
                foreach (var exec in taskExecutions)
                {
                    usedExecutionIds.Add(exec.Id);
                    result.Add(new WorkflowStepView { Task = task, Execution = exec });
                }
            }
            else
            {
                result.Add(new WorkflowStepView { Task = task, Execution = null });
            }
        }

        return result;
    }
    #endregion

    #region Actions
    private async Task ReopenWorkflowAsync(HistoryWorkflowView item)
    {
        try
        {
            bool? result = await dialogService.ShowMessageBox(
                languageContainer.Keys["ReopenWorkflowTitle"],
                languageContainer.Keys["ReopenWorkflowDescription"],
                yesText: languageContainer.Keys["Yes"], cancelText: languageContainer.Keys["No"]);

            if (result != true)
                return;

            processing = true;
            StateHasChanged();

            var seriesId = item.WorkflowExecutionSeriesId;
            var veichle = item.Veichle;

            // Find the last execution to reconstruct the open entry
            var lastExec = workflowExecutions
                .Where(e => e.WorkflowExecutionSeriesId == seriesId)
                .OrderByDescending(e => e.OpenAt)
                .FirstOrDefault();

            if (lastExec == null)
            {
                snackbar.Add("Nessuna esecuzione trovata per questa serie.", Severity.Error);
                await appLogger.LogErrorAsync("Riapertura workflow fallita: nessuna esecuzione trovata per la serie", new LogContext { WorkflowExecutionId = seriesId, VeichleId = veichle.Id });
                return;
            }

            // Remove from completed, add back to open workflows
            veichle.WorkflowExecutionsCompleted?.Remove(seriesId);

            if (veichle.OpenWorkflows == null)
                veichle.OpenWorkflows = new List<OpenWorkflowEntry>();

            veichle.OpenWorkflows.Add(new OpenWorkflowEntry
            {
                WorkflowId = lastExec.WorkflowId,
                WorkflowTaskId = lastExec.WorkflowTaskId,
                WorkflowExecutionId = lastExec.Id,
                WorkflowExecutionSeriesId = seriesId
            });

            veichle.HasOpenWorkflow = true;
            veichle.UpdateDate = DateTime.UtcNow;

            await dbDependency.GetDataAccessVeichle().UpdateAsync(veichle);
            snackbar.Add(languageContainer.Keys["ReopenWorkflowSuccess"], Severity.Success);
            await appLogger.LogInformationAsync("Workflow riaperto", new LogContext { WorkflowExecutionId = seriesId, VeichleId = item.Veichle.Id, WorkflowId = lastExec.WorkflowId, EmployeeId = employee?.Id });

            // Refresh data
            var previousVeichleId = veichle.Id;
            await GetVeichle();
            selectedVeichle = veichles.FirstOrDefault(v => v.Id == previousVeichleId) ?? new Veichle();
            await UpdateSelectedVeichle(selectedVeichle);
        }
        catch (Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
            await appLogger.LogErrorAsync("Errore riapertura workflow", new LogContext { WorkflowExecutionId = item.WorkflowExecutionSeriesId }, ex);
        }
        finally
        {
            processing = false;
            StateHasChanged();
        }
    }

    private async Task ViewReportAsync(HistoryWorkflowView item)
    {
        try
        {
            processing = true;
            StateHasChanged();

            var seriesId = item.WorkflowExecutionSeriesId;
            var elements = workflowExecutions.Where(x => x.WorkflowExecutionSeriesId.Equals(seriesId));
            var wf = workflows.FirstOrDefault(x => x.Id.Equals(item.WorkflowId)) ?? new Workflow();
            var wft = workflowTasks.Where(x => x.WorkflowId.Equals(wf.Id));

            var report = await Utility.FillTemplate(languageContainer,
                                                    employee ?? new Employee(), selectedCustomer, selectedVeichle,
                                                    wf, wft, elements, dbDependency);

            var color = wf.Color ?? "";
            var parameters = new DialogParameters<ViewHistory>
            {
                {
                    x => x.Dataset,
                    new ViewHistoryflowDialogParameter()
                    {
                        worflowReport = report,
                        worflowTitle = wf.Title ?? "",
                        worflowDate = elements.Min(x => x.OpenAt) ?? DateTime.UtcNow,
                        worflowStyle = $"color: {color};",
                        images = elements?.SelectMany(x => x.Images ?? new List<Image>()).ToList() ?? new List<Image>(),
                        components = elements?.SelectMany(x => x.Components ?? new List<Component>()).ToList() ?? new List<Component>(),
                        useComponents = false,
                        useImages = false,
                        useReports = true
                    }
                }
            };

            var dialog = await dialogService.ShowAsync<ViewHistory>(@languageContainer.Keys["ResumingWorkflow"], parameters, dialogOptions);
            await appLogger.LogInformationAsync("Report workflow visualizzato", new LogContext { WorkflowExecutionId = seriesId, VeichleId = item.Veichle.Id, WorkflowId = item.WorkflowId, EmployeeId = employee?.Id });
            await dialog.Result;
        }
        catch (Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
            await appLogger.LogErrorAsync("Errore visualizzazione report", new LogContext { WorkflowExecutionId = item.WorkflowExecutionSeriesId }, ex);
        }
        finally
        {
            processing = false;
            StateHasChanged();
        }
    }

    private async Task ViewStepAsync(HistoryWorkflowView item, WorkflowStepView step)
    {
        try
        {
            if (step.Execution == null) return;

            var currentWorkflow = workflows.FirstOrDefault(x => x.Id.Equals(item.WorkflowId)) ?? new Workflow();
            var components = await dbDependency.GetDataAccessComponent().FindAsync(new SearcherComponent()) ?? new List<Component>();

            var parameters = new DialogParameters<ResumeWorkflow>
            {
                {
                    x => x.Dataset,
                    new ResumeWorkflowDialogParameter()
                    {
                        employee = employee!,
                        customer = selectedCustomer,
                        veichle = item.Veichle,
                        workflow = currentWorkflow,
                        workflowTask = step.Task,
                        workflowExecution = step.Execution,
                        components = components,
                        editOneExecution = false,
                        viewOneExecution = true
                    }
                }
            };

            var dialog = await dialogService.ShowAsync<ResumeWorkflow>(@languageContainer.Keys["ResumingWorkflow"], parameters, dialogOptions);
            await dialog.Result;
        }
        catch (Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            StateHasChanged();
        }
    }
    #endregion
}
