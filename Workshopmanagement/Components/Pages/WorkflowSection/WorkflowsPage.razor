@page "/workflows"

@inject IJSRuntime JSRuntime
@inject IDbDependency dbDependency
@inject ISnackbar snackbar
@inject ILanguageContainerService languageContainer
@inject IDialogService dialogService
@inject ProtectedLocalStorage protectedLocalStorage
@inject NavigationManager navigationManager

<MudContainer Class="loading-overlay" Style="@(processing ? "display:flex;" : "display:none;")">
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
</MudContainer>

<MudGrid>
    <MudItem xs="12">
        <MudGrid>
            <MudItem xs="6" Style="text-align: left;">
                <MudButton OnClick="@(() => OpenCreateWorkflowDialogAsync() )" Variant="Variant.Filled" Color="Color.Info">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Style="margin-right:2px;"/>
                    <MudIcon Icon="@Icons.Material.Filled.Workspaces"/>
                    <MudText Style="margin-left: 15px">@languageContainer.Keys["StartNewWorkflow"]</MudText>                       
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudItem>
    <MudItem xs="12">
        <MudDataGrid @ref="dataGrid" T="VeichleWorkflowView" Items="@gridItems" ReadOnly="true"
                        Filterable="true" Dense="false" Hover="true" SortMode="@SortMode.Single" Bordered="true">
            <Columns>
                <TemplateColumn Title="" Sortable="false" HeaderStyle="width: 110px;">
                    <CellTemplate>
                        @{
                            var seriesId = context.Item.Entry.WorkflowExecutionSeriesId;
                            var isActive = IsTrackingActive(seriesId);
                            var isScheduledFuture = IsStartDateInFuture(seriesId);
                        }
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Justify="Justify.Center">
                            @if (isScheduledFuture)
                            {
                                <MudTooltip Text="@languageContainer.Keys["WorkflowFutureScheduled"]">
                                    <MudChip T="string" Icon="@Icons.Material.Filled.Schedule" Color="Color.Warning" Size="Size.Small" Style="font-size:0.7rem;">
                                        @Utility.GetDateFormatted(GetSeriesStartDate(seriesId), Utility.DateFormat.OnlyDate)
                                        @if (GetSeriesStartDate(seriesId) is { } sd2 && (sd2.Hour != 0 || sd2.Minute != 0))
                                        {
                                            <span class="ml-1">@Utility.GetDateFormatted(sd2, Utility.DateFormat.OnlyTime)</span>
                                        }
                                    </MudChip>
                                </MudTooltip>
                            }
                            else
                            {
                                <MudButton OnClick="@(() => StartTrackingAsync(context.Item))"
                                           StartIcon="@Icons.Material.Filled.PlayArrow" Variant="Variant.Filled"
                                           Color="Color.Success" Size="Size.Small"
                                           Disabled="@isActive"
                                           Style="@(isActive ? "opacity: 0.3; min-width: 40px;" : "min-width: 40px;")" />
                                <MudButton OnClick="@(() => StopTrackingAsync(context.Item))"
                                           StartIcon="@Icons.Material.Filled.Stop" Variant="Variant.Filled"
                                           Color="Color.Error" Size="Size.Small"
                                           Disabled="@(!isActive)"
                                           Style="@(!isActive ? "opacity: 0.3; min-width: 40px;" : "min-width: 40px;")" />
                            }
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
                <HierarchyColumn T="VeichleWorkflowView" />

                <TemplateColumn Title="@languageContainer.Keys["WorkflowColStartDate"]" Sortable="false">
                    <CellTemplate>
                        @{
                            var sd = GetSeriesStartDate(context.Item.Entry.WorkflowExecutionSeriesId);
                            @Utility.GetDateFormatted(sd, Utility.DateFormat.OnlyDate)
                            @if (sd.HasValue && (sd.Value.Hour != 0 || sd.Value.Minute != 0))
                            {
                                <MudText Typo="Typo.caption" Class="ml-1">@Utility.GetDateFormatted(sd, Utility.DateFormat.OnlyTime)</MudText>
                            }
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@languageContainer.Keys["WorkkflowStartStep5EstimatedHours"]" Sortable="false">
                    <CellTemplate>
                        @{
                            var h = GetSeriesEstimatedHours(context.Item.Entry.WorkflowExecutionSeriesId);
                            var m = GetSeriesEstimatedMinutes(context.Item.Entry.WorkflowExecutionSeriesId);
                            <span>@((h.HasValue || m.HasValue) ? $"{(h.HasValue ? h.Value + "h" : "")} {(m.HasValue && m.Value > 0 ? m.Value + "m" : "")}".Trim() : "-")</span>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@languageContainer.Keys["WorkflowColAssigned"]" Sortable="false">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">@GetSeriesEmployeeNames(context.Item.Entry.WorkflowExecutionSeriesId)</MudText>
                    </CellTemplate>
                </TemplateColumn>

                <PropertyColumn Property="x => x.Veichle.LicensePlate" Title="@languageContainer.Keys["LicensePlate"]" Required="true" Editable="false" Sortable="true" Hidden="false" />
                <TemplateColumn Title="@languageContainer.Keys["TimeTrackingHoursSpent"]" Sortable="false">
                    <CellTemplate>
                        <MudText Typo="Typo.body2">@GetTrackingTime(context.Item.Entry.WorkflowExecutionSeriesId)</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => Utility.TruncateFroHtml(x.Veichle.Model, 50)" Title="@languageContainer.Keys["Model"]" Required="true" Editable="false" Sortable="true" Hidden="false" />
                <PropertyColumn Property="x => GetUserInfo(x.Veichle.UserId).denomination" Title="@languageContainer.Keys["Customer"]" Required="true" Editable="false" Sortable="true" Hidden="false" />
                <PropertyColumn Property="x => GetUserInfo(x.Veichle.UserId).fiscalcodeOrVat" Title="@languageContainer.Keys["FiscalCodeOrVatNumber"]" Required="true" Editable="false" Sortable="true" Hidden="false" />
                <TemplateColumn Title="@languageContainer.Keys["OpenWorkflow"]" Sortable="false">
                    <CellTemplate>
                        @{
                            var wfInfo = GetWorkflowInfoFull(context.Item.Entry.WorkflowId);
                        }
                        <MudChip T="string" Style="@($"background-color:{wfInfo.color}; color:white;")" Size="Size.Small">@wfInfo.title</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => GetWorkflowTaskInfo(x.Entry.WorkflowTaskId)" Title="@languageContainer.Keys["WorkflowTaskInfo"]" Required="true" Editable="false" Sortable="true" Hidden="false" />
                <TemplateColumn Title="@languageContainer.Keys["WorkflowTaskCompletion"]">
                    <CellTemplate>
                        @{
                            var pct = GetPercentageOfCompleteness(context.Item.Entry.WorkflowExecutionSeriesId, context.Item.Entry.WorkflowId);
                        }
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudProgressCircular Color="Color.Info" Size="Size.Small" Value="@pct" />
                            <MudText Typo="Typo.caption">@($"{(int)pct}%")</MudText>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="@languageContainer.Keys["WorkflowCompleteColumn"]" Hidden="false" CellClass="justify-end">
                    <CellTemplate>
                        @{
                            var seriesIdClose = context.Item.Entry.WorkflowExecutionSeriesId;
                            var pctClose = GetPercentageOfCompleteness(seriesIdClose, context.Item.Entry.WorkflowId);
                            var cannotComplete = IsStartDateInFuture(seriesIdClose)
                                || IsTrackingActive(seriesIdClose)
                                || pctClose < 100;
                        }
                        <MudIconButton OnClick="@(() => CloseWorkflowAsync(context.Item))"
                            Color="Color.Success" Size="@Size.Small" Icon="@Icons.Material.Filled.BlindsClosed" Variant="Variant.Filled"
                            Disabled="@cannotComplete" Style="@(cannotComplete ? "opacity: 0.3;" : "")" />
                    </CellTemplate>
                </TemplateColumn>

                <TemplateColumn Title="" Sortable="false" HeaderStyle="width: 50px;" Hidden="@(employee == null || employee.EmployeeRole != EmployeeRole.Manager)">
                    <CellTemplate>
                        <MudTooltip Text="@languageContainer.Keys["WorkflowEditSchedule"]">
                            <MudIconButton OnClick="@(() => OpenEditScheduleAsync(context.Item))"
                                Color="Color.Info" Size="@Size.Small" Icon="@Icons.Material.Filled.EditCalendar" Variant="Variant.Outlined" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                    
            </Columns>

            <ChildRowContent>
                <td colspan="100" style="padding: 0;">
                    <MudCard Outlined="true" Elevation="0" Class="ma-3">
                        <MudCardContent Style="padding: 8px;">
                            <MudSimpleTable Dense="true" Hover="true" Bordered="true" Striped="true" Style="background-color: transparent; width: 100%;">
                                <thead>
                                    <tr>
                                        <th style="width: 90px;"></th>
                                        <th style="width: 60px; text-align: center;">@languageContainer.Keys["StepCompleted"]</th>
                                        <th>@languageContainer.Keys["StepTitleHistory"]</th>
                                        <th>@languageContainer.Keys["StepTitleExHistory"]</th>
                                        <th style="width: 60px; text-align: center;">@languageContainer.Keys["StepTitleStatus"]</th>
                                        <th style="width: 60px; text-align: center;">@languageContainer.Keys["StepTitleOutcome"]</th>
                                        <th>@languageContainer.Keys["OpenAt"]</th>
                                        <th>@languageContainer.Keys["ClosedAt"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var step in GetStepsForWorkflow(context.Item))
                                    {
                                        if (step.Task.TaskOrder < 0)
                                            continue;
                                        <tr style="@(step.IsCurrentStep ? "background-color: rgba(28, 144, 243, 0.12); font-weight: 500;" : "")">
                                            <td>
                                                <MudStack Row="true" Spacing="1">
                                                    @if (step.Execution != null && CanEditStep(step))
                                                    {
                                                        <MudIconButton OnClick="@(() => OpenEditStepAsync(context.Item, step))"
                                                                       Color="Color.Warning" Size="@Size.Small"
                                                                       Icon="@Icons.Material.Filled.Edit" Variant="Variant.Outlined"
                                                                       Disabled="@(!IsTrackingActive(context.Item.Entry.WorkflowExecutionSeriesId))" />
                                                    }
                                                    @if (step.Execution != null && step.Task.AllowLoop && CanEditStep(step))
                                                    {
                                                        <MudIconButton OnClick="@(() => DuplicateStepAsync(context.Item, step))"
                                                                       Color="Color.Success" Size="@Size.Small"
                                                                       Icon="@Icons.Material.Filled.ContentCopy" Variant="Variant.Outlined"
                                                                       Disabled="@(!IsTrackingActive(context.Item.Entry.WorkflowExecutionSeriesId))"
                                                                       title='@languageContainer.Keys["Duplica"]' />
                                                    }
                                                    @if (step.Execution != null && !CanEditStep(step))
                                                    {
                                                        <MudIconButton OnClick="@(() => OpenViewStepAsync(context.Item, step))"
                                                                       Color="Color.Info" Size="@Size.Small"
                                                                       Icon="@Icons.Material.Filled.RemoveRedEye" Variant="Variant.Outlined" />
                                                    }
                                                </MudStack>
                                            </td>
                                            <td style="text-align: center;">
                                                @if (step.Execution != null && step.Execution.IsCompleted)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                                }
                                            </td>
                                            <td>@Utility.TruncateFroHtml(step.Task.Title, 40)</td>
                                            <td>@(step.Execution != null ? Utility.TruncateFroHtml(step.Execution.Titile, 40) : "-")</td>
                                            <td style="text-align: center;">
                                                @if (step.Execution != null)
                                                {
                                                    @if (step.Execution.ExecutionStatus == WorkflowExecutionStatus.InProgress)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled._360" Color="Color.Info" Size="Size.Small" />
                                                    }
                                                    else if (step.Execution.ExecutionStatus == WorkflowExecutionStatus.Todo)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.AssignmentReturned" Color="Color.Default" Size="Size.Small" />
                                                    }
                                                    else if (step.Execution.ExecutionStatus == WorkflowExecutionStatus.Skipped)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.AirlineStops" Color="Color.Warning" Size="Size.Small" />
                                                    }
                                                    else if (step.Execution.ExecutionStatus == WorkflowExecutionStatus.Closed)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Color="Color.Success" Size="Size.Small" />
                                                    }
                                                }
                                                else
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Default" Size="Size.Small" />
                                                }
                                            </td>
                                            <td style="text-align: center;">
                                                @if (step.Execution != null)
                                                {
                                                    @if (step.Execution.Executionoutcome == WorkflowExecutionoutcome.RunningOut)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.GasMeter" Color="Color.Warning" Size="Size.Small" />
                                                    }
                                                    else if (step.Execution.Executionoutcome == WorkflowExecutionoutcome.ToBeReplaced)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.Build" Color="Color.Warning" Size="Size.Small" />
                                                    }
                                                    else if (step.Execution.Executionoutcome == WorkflowExecutionoutcome.ToBeVerified)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.Engineering" Color="Color.Warning" Size="Size.Small" />
                                                    }
                                                    else if (step.Execution.Executionoutcome == WorkflowExecutionoutcome.Replaced)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.ThumbUp" Color="Color.Success" Size="Size.Small" />
                                                    }
                                                    else if (step.Execution.Executionoutcome == WorkflowExecutionoutcome.Verified)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.Done" Color="Color.Success" Size="Size.Small" />
                                                    }
                                                    else if (step.Execution.Executionoutcome == WorkflowExecutionoutcome.Ok)
                                                    {
                                                        <MudIcon Icon="@Icons.Material.Filled.DoneAll" Color="Color.Success" Size="Size.Small" />
                                                    }
                                                }
                                            </td>
                                            <td>@(step.Execution != null ? Utility.GetDateFormatted(step.Execution.OpenAt, Utility.DateFormat.FullDate) : "")</td>
                                            <td>@(step.Execution != null ? Utility.GetDateFormatted(step.Execution.ClosedAt, Utility.DateFormat.FullDate) : "")</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudCardContent>
                    </MudCard>
                </td>
            </ChildRowContent>

            <PagerContent>
                <MudDataGridPager T="VeichleWorkflowView" PageSizeOptions="@Utility.pageSizeOptions" RowsPerPageString="@languageContainer.Keys["RowsPerPageString"]" />
            </PagerContent>
        </MudDataGrid>
    </MudItem>
</MudGrid>



@code {
    private Employee? employee;
    private List<Customer> customers = new List<Customer>();
    private List<Employee> employees = new List<Employee>();
    private List<Veichle> veichles = new List<Veichle>();
    private List<VeichleWorkflowView> gridItems = new List<VeichleWorkflowView>();
    private List<Workflow> workflows = new List<Workflow>();
    private List<WorkflowTask> workflowTasks = new List<WorkflowTask>();
    private List<WorkflowExecution> workflowExecutions = new List<WorkflowExecution>();
    private MudDataGrid<VeichleWorkflowView> dataGrid { get; set; } = null!;
    private DialogOptions dialogOptions = new DialogOptions 
    { 
        FullScreen = true,
        CloseButton = true,
        CloseOnEscapeKey = true 
    };

    private bool processing = true;

    // Time tracking
    private Dictionary<string, TimeTracking> trackingsBySeriesId = new Dictionary<string, TimeTracking>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                processing = true;
                var isUserLogged = await Utility.IsUserLoggedInAsync(protectedLocalStorage);
                if (!isUserLogged)
                {
                    snackbar.Add(@languageContainer.Keys["LoginExpiredError"], Severity.Warning);
                    navigationManager.NavigateTo($"login");
                }
                employee = await Utility.GetCurrentLoggedEmployee(protectedLocalStorage);

                await GetCustomers();
                await GetVeichles();
                await GetWorkflows();
                await GetWorkflowTasks();
                await GetWorkflowExecutions();
                await GetEmployees();
                await LoadTimeTrackingStates();
            }

        }
        catch (Exception ex)
        {
            if (!ex.Message.Contains("was not found in the key ring. For more information go to https://aka.ms/aspnet/dataprotectionwarning"))
                snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            if (processing)
            {
                processing = false;
                if(firstRender)
                    StateHasChanged();
            }
        }
    }

    #region GetData
    private async Task GetCustomers()
    {
        customers = await dbDependency.GetDataAccessCustomer().FindAsync(new SearcherCustomer());
    }
    private async Task GetVeichles()
    {
        veichles = await dbDependency.GetDataAccessVeichle().FindAsync(new SearcherVeichle());
        RefreshGridItems();
    }
    private async Task GetWorkflows()
    {
        workflows = await dbDependency.GetDataAccessWorkflow().FindAsync(new SearcherWorkflow());
    }
    private async Task GetWorkflowTasks()
    {
        workflowTasks = await dbDependency.GetDataAccessWorkflowTask().FindAsync(new SearcherWorkflowTask());
    }
    private async Task GetWorkflowExecutions()
    {
        workflowExecutions = new List<WorkflowExecution>();

        var openSeriesIds = veichles
            .Where(v => v.HasOpenWorkflow && v.OpenWorkflows != null)
            .SelectMany(v => v.OpenWorkflows.Select(e => e.WorkflowExecutionSeriesId))
            .Where(id => !string.IsNullOrEmpty(id))
            .Distinct()
            .ToList();

        foreach (var seriesId in openSeriesIds)
        {
            var executions = await dbDependency.GetDataAccessWorkflowExecution().FindAsync(
                new SearcherWorkflowExecution { WorkflowExecutionSeriesId = seriesId });
            workflowExecutions.AddRange(executions);
        }

        // Sort grid items by StartDate ascending (oldest first, items without date go last)
        gridItems = gridItems
            .OrderBy(x => workflowExecutions
                .FirstOrDefault(e => e.WorkflowExecutionSeriesId == x.Entry.WorkflowExecutionSeriesId)?.StartDate ?? DateTime.MaxValue)
            .ToList();
    }
    private async Task GetEmployees()
    {
        employees = await dbDependency.GetDataAccessEmployee().FindAsync(new SearcherEmployee());
    }
    #endregion

    #region TimeTracking
    private async Task LoadTimeTrackingStates()
    {
        if (employee == null) return;
        trackingsBySeriesId.Clear();

        var allTrackings = await dbDependency.GetDataAccessTimeTracking().FindAsync(
            new SearcherTimeTracking { EmployeeId = employee.Id });

        foreach (var t in allTrackings)
        {
            trackingsBySeriesId[t.WorkflowExecutionSeriesId] = t;
        }

    }

    private bool IsTrackingActive(string seriesId)
    {
        if (string.IsNullOrEmpty(seriesId)) return false;
        return trackingsBySeriesId.TryGetValue(seriesId, out var t) && t.IsActive;
    }

    private string GetTrackingTime(string seriesId)
    {
        if (string.IsNullOrEmpty(seriesId)) return "00:00:00";
        if (!trackingsBySeriesId.TryGetValue(seriesId, out var t)) return "00:00:00";
        var total = TimeSpan.FromTicks(t.Sessions
            .Where(s => s.EndTime.HasValue)
            .Sum(s => (s.EndTime!.Value - s.StartTime).Ticks));
        return $"{(int)total.TotalHours:D2}:{total.Minutes:D2}:{total.Seconds:D2}";
    }

    private async Task StartTrackingAsync(VeichleWorkflowView item)
    {
        try
        {
            var seriesId = item.Entry.WorkflowExecutionSeriesId;
            var employeeId = employee!.Id;

            // Check if user has another active tracking
            var otherActive = trackingsBySeriesId.Values.FirstOrDefault(t => t.IsActive && t.WorkflowExecutionSeriesId != seriesId);

            if (otherActive != null)
            {
                bool? result = await dialogService.ShowMessageBox(
                    languageContainer.Keys["TimeTrackingAlreadyActiveTitle"],
                    languageContainer.Keys["TimeTrackingAlreadyActiveDescription"],
                    yesText: languageContainer.Keys["Yes"], cancelText: languageContainer.Keys["No"]);

                if (result != true)
                    return;

                // Stop the other active tracking
                var activeSession = otherActive.Sessions.LastOrDefault();
                if (activeSession != null && activeSession.EndTime == null)
                    activeSession.EndTime = DateTime.Now;
                otherActive.IsActive = false;
                await dbDependency.GetDataAccessTimeTracking().UpdateAsync(otherActive);
            }

            // Start tracking for this workflow
            if (trackingsBySeriesId.TryGetValue(seriesId, out var existing))
            {
                existing.IsActive = true;
                existing.Sessions.Add(new TimeTrackingSession { StartTime = DateTime.Now });
                await dbDependency.GetDataAccessTimeTracking().UpdateAsync(existing);
            }
            else
            {
                var newTracking = new TimeTracking
                {
                    Id = Guid.NewGuid().ToString(),
                    EmployeeId = employeeId,
                    WorkflowExecutionSeriesId = seriesId,
                    IsActive = true,
                    Sessions = new List<TimeTrackingSession>
                    {
                        new TimeTrackingSession { StartTime = DateTime.Now }
                    }
                };
                await dbDependency.GetDataAccessTimeTracking().InsertAsync(newTracking);
                trackingsBySeriesId[seriesId] = newTracking;
            }

            snackbar.Add(languageContainer.Keys["TimeTrackingStarted"], Severity.Success);

            // Add employee to AssignedEmployeeIds on the current execution
            var startExecution = workflowExecutions.FirstOrDefault(e => e.Id == item.Entry.WorkflowExecutionId);
            if (startExecution != null)
            {
                if (startExecution.AssignedEmployeeIds == null)
                    startExecution.AssignedEmployeeIds = new List<string>();
                if (!startExecution.AssignedEmployeeIds.Contains(employeeId))
                {
                    startExecution.AssignedEmployeeIds.Add(employeeId);
                    await dbDependency.GetDataAccessWorkflowExecution().UpdateAsync(startExecution);
                }
            }
        }
        catch (Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task StopTrackingAsync(VeichleWorkflowView item)
    {
        try
        {
            var seriesId = item.Entry.WorkflowExecutionSeriesId;
            if (!trackingsBySeriesId.TryGetValue(seriesId, out var tracking)) return;

            var activeSession = tracking.Sessions.LastOrDefault();
            if (activeSession != null && activeSession.EndTime == null)
                activeSession.EndTime = DateTime.Now;

            tracking.IsActive = false;
            await dbDependency.GetDataAccessTimeTracking().UpdateAsync(tracking);

            // Remove employee from AssignedEmployeeIds on the current execution
            var stopExecution = workflowExecutions.FirstOrDefault(e => e.Id == item.Entry.WorkflowExecutionId);
            if (stopExecution != null && stopExecution.AssignedEmployeeIds != null)
            {
                stopExecution.AssignedEmployeeIds.Remove(employee!.Id);
                await dbDependency.GetDataAccessWorkflowExecution().UpdateAsync(stopExecution);
            }

            StateHasChanged();
            snackbar.Add(languageContainer.Keys["TimeTrackingStopped"], Severity.Info);
        }
        catch (Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
        }
    }

    #endregion

    #region GetGridData
    private class VeichleWorkflowView
    {
        public Veichle Veichle { get; set; } = null!;
        public OpenWorkflowEntry Entry { get; set; } = null!;
    }

    private class WorkflowStepView
    {
        public WorkflowTask Task { get; set; } = new WorkflowTask();
        public WorkflowExecution? Execution { get; set; }
        public bool IsCurrentStep { get; set; }
    }

    private void RefreshGridItems()
    {
        if (veichles == null) { gridItems = new List<VeichleWorkflowView>(); return; }

        var newEntries = veichles
            .Where(x => x.HasOpenWorkflow && x.OpenWorkflows != null)
            .SelectMany(v => v.OpenWorkflows.Select(entry => new { Veichle = v, Entry = entry }))
            .ToList();

        var newGridItems = new List<VeichleWorkflowView>();
        foreach (var ni in newEntries)
        {
            var existing = gridItems.FirstOrDefault(g =>
                g.Entry.WorkflowExecutionSeriesId == ni.Entry.WorkflowExecutionSeriesId);
            if (existing != null)
            {
                existing.Veichle = ni.Veichle;
                existing.Entry = ni.Entry;
                newGridItems.Add(existing);
            }
            else
            {
                newGridItems.Add(new VeichleWorkflowView { Veichle = ni.Veichle, Entry = ni.Entry });
            }
        }
        gridItems = newGridItems;
    }

    private List<WorkflowStepView> GetStepsForWorkflow(VeichleWorkflowView item)
    {
        var result = new List<WorkflowStepView>();
        var entry = item.Entry;

        var tasksForWorkflow = workflowTasks
            .Where(t => t.WorkflowId == entry.WorkflowId)
            .OrderBy(t => t.TaskOrder)
            .ToList();

        var executionsForSeries = workflowExecutions
            .Where(e => e.WorkflowExecutionSeriesId == entry.WorkflowExecutionSeriesId)
            .ToList();

        var usedExecutionIds = new HashSet<string>();

        foreach (var task in tasksForWorkflow)
        {
            var taskExecutions = executionsForSeries
                .Where(e => e.WorkflowTaskId == task.Id && !usedExecutionIds.Contains(e.Id))
                .OrderBy(e => e.OpenAt ?? DateTime.MaxValue)
                .ToList();

            if (taskExecutions.Any())
            {
                foreach (var exec in taskExecutions)
                {
                    usedExecutionIds.Add(exec.Id);
                    result.Add(new WorkflowStepView
                    {
                        Task = task,
                        Execution = exec,
                        IsCurrentStep = exec.Id == entry.WorkflowExecutionId
                    });
                }
            }
            else
            {
                result.Add(new WorkflowStepView
                {
                    Task = task,
                    Execution = null,
                    IsCurrentStep = false
                });
            }
        }

        return result;
    }

    private bool CanEditStep(WorkflowStepView step)
    {
        if (step.Execution == null) return false;

        return step.IsCurrentStep
            || step.Execution.ExecutionStatus == WorkflowExecutionStatus.Todo
            || step.Execution.ExecutionStatus == WorkflowExecutionStatus.InProgress
            || step.Execution.Executionoutcome == WorkflowExecutionoutcome.RunningOut
            || step.Execution.Executionoutcome == WorkflowExecutionoutcome.ToBeVerified
            || step.Execution.Executionoutcome == WorkflowExecutionoutcome.ToBeReplaced;
    }

    private (string denomination, string fiscalcodeOrVat) GetUserInfo(string userId)
    {
        if (String.IsNullOrEmpty(userId))
            return ("", "");

        var item = customers.FirstOrDefault(x => x.Id.Equals(userId)) ?? new Customer();

        return ($"{item.Name} {item.Surname}", (item.IsCompany ? item.VatNumber : item.FiscalCode) ?? "");
    }

    private double GetPercentageOfCompleteness(string? seriesId, string? currentWorkflowId)
    {
        try{
            if (String.IsNullOrEmpty(seriesId) || String.IsNullOrEmpty(currentWorkflowId))
                return 0;

            var totalTasks = workflowTasks.Where(x => x.WorkflowId.Equals(currentWorkflowId) && x.TaskOrder >= 0 && !x.CanBeSkipped).Count();
            if (totalTasks == 0)
                totalTasks = 1;

            var completedCount = workflowExecutions
                .Where(e => e.WorkflowExecutionSeriesId == seriesId && e.IsCompleted)
                .Select(e => e.WorkflowTaskId)
                .Distinct()
                .Count();

            var val = (Convert.ToDouble(completedCount) / Convert.ToDouble(totalTasks)) * 100.0;
            return val;
        }catch(Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
            return 1;
        }
       
    }

