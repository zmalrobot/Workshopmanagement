    private DateTime? GetSeriesStartDate(string? seriesId)
    {
        if (string.IsNullOrEmpty(seriesId)) return null;
        return workflowExecutions.FirstOrDefault(e => e.WorkflowExecutionSeriesId == seriesId)?.StartDate;
    }

    private int? GetSeriesEstimatedHours(string? seriesId)
    {
        if (string.IsNullOrEmpty(seriesId)) return null;
        return workflowExecutions.FirstOrDefault(e => e.WorkflowExecutionSeriesId == seriesId)?.EstimatedHours;
    }

    private int? GetSeriesEstimatedMinutes(string? seriesId)
    {
        if (string.IsNullOrEmpty(seriesId)) return null;
        return workflowExecutions.FirstOrDefault(e => e.WorkflowExecutionSeriesId == seriesId)?.EstimatedMinutes;
    }

    private bool IsStartDateInFuture(string? seriesId)
    {
        if (string.IsNullOrEmpty(seriesId)) return false;
        var startDate = GetSeriesStartDate(seriesId);
        return startDate.HasValue && startDate.Value.Date > DateTime.Today;
    }

    private string GetSeriesEmployeeNames(string? seriesId)
    {
        if (string.IsNullOrEmpty(seriesId)) return "-";
        var employeeIds = workflowExecutions
            .Where(e => e.WorkflowExecutionSeriesId == seriesId && e.AssignedEmployeeIds != null)
            .SelectMany(e => e.AssignedEmployeeIds!)
            .Distinct()
            .ToList();
        if (!employeeIds.Any()) return "-";
        var names = employeeIds
            .Select(id => employees.FirstOrDefault(emp => emp.Id == id))
            .Where(emp => emp != null)
            .Select(emp => $"{emp!.Name} {emp.Surname}")
            .ToList();
        return names.Any() ? string.Join(", ", names) : "-";
    }
