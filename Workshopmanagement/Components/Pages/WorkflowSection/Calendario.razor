@page "/calendario"

@inject IJSRuntime JSRuntime
@inject IDbDependency dbDependency
@inject ISnackbar snackbar
@inject ILanguageContainerService languageContainer
@inject ProtectedLocalStorage protectedLocalStorage
@inject NavigationManager navigationManager

<MudContainer Class="loading-overlay" Style="@(processing ? "display:flex;" : "display:none;")">
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
</MudContainer>

<MudGrid>
    <MudItem xs="12">
        <MudText Typo="Typo.h5">@languageContainer.Keys["CalendarioTitle"]</MudText>
    </MudItem>
    <MudItem xs="12">
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-3">

            <!-- ═══ TAB 1 — Calendario appuntamenti ═══ -->
            <MudTabPanel Text="@languageContainer.Keys["CalendarioAppuntamenti"]">
                <MudGrid>
                    <MudItem xs="12">
                        <MudGrid AlignItems="AlignItems.Center">
                            <MudItem xs="4">
                                <MudButtonGroup Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small">
                                    <MudButton OnClick="PrevWeek" StartIcon="@Icons.Material.Filled.ChevronLeft">@languageContainer.Keys["CalendarioPrev"]</MudButton>
                                    <MudButton OnClick="GoToToday">@languageContainer.Keys["CalendarioOggi"]</MudButton>
                                    <MudButton OnClick="NextWeek" EndIcon="@Icons.Material.Filled.ChevronRight">@languageContainer.Keys["CalendarioNext"]</MudButton>
                                </MudButtonGroup>
                            </MudItem>
                            <MudItem xs="4" Style="text-align:center;">
                                <MudText Typo="Typo.h6">@GetWeekLabel()</MudText>
                            </MudItem>
                            <MudItem xs="4" Style="text-align:right;">
                                <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Circle" Style="background-color:#1976d2;color:white;">@languageContainer.Keys["CalendarioLegendaAperto"]</MudChip>
                                <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Circle" Style="background-color:#2e7d32;color:white;">@languageContainer.Keys["CalendarioLegendaInLavoro"]</MudChip>
                                <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Circle" Style="background-color:#9e9e9e;color:white;">@languageContainer.Keys["CalendarioLegendaChiuso"]</MudChip>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        @RenderWeekCalendar(BuildAppuntamentiEvents(), currentWeekStart, false, true)
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <!-- ═══ TAB 2 — Calendario lavorazioni ═══ -->
            <MudTabPanel Text="@languageContainer.Keys["CalendarioLavorazioni"]">
                <MudGrid>
                    <MudItem xs="12">
                        <MudGrid AlignItems="AlignItems.Center">
                            <MudItem xs="3">
                                <MudButtonGroup Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small">
                                    <MudButton OnClick="PrevWeekL" StartIcon="@Icons.Material.Filled.ChevronLeft">@languageContainer.Keys["CalendarioPrev"]</MudButton>
                                    <MudButton OnClick="GoToTodayL">@languageContainer.Keys["CalendarioOggi"]</MudButton>
                                    <MudButton OnClick="NextWeekL" EndIcon="@Icons.Material.Filled.ChevronRight">@languageContainer.Keys["CalendarioNext"]</MudButton>
                                </MudButtonGroup>
                            </MudItem>
                            <MudItem xs="3" Style="text-align:center;">
                                <MudText Typo="Typo.h6">@GetWeekLabelL()</MudText>
                            </MudItem>
                            <MudItem xs="3">
                                <MudSelect T="string" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"

                                           Value="selectedEmployeeId"
                                           ValueChanged="@(v => { selectedEmployeeId = v; StateHasChanged(); })">
                                    <MudSelectItem T="string" Value="@("")">— @languageContainer.Keys["CalendarioTuttiOperatori"] —</MudSelectItem>
                                    @foreach (var emp in employees.OrderBy(e => e.Surname))
                                    {
                                        <MudSelectItem T="string" Value="@emp.Id">@emp.Name @emp.Surname</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="3" Style="text-align:right;">
                                <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Circle" Style="background-color:#2e7d32;color:white;">@languageContainer.Keys["CalendarioLegendaInLavoro"]</MudChip>
                                <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Circle" Style="background-color:#1976d2;color:white;">@languageContainer.Keys["CalendarioLegendaChiuso"]</MudChip>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        @RenderWeekCalendar(BuildLavorazioniEvents(selectedEmployeeId), currentWeekStartL)
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

        </MudTabs>
    </MudItem>
</MudGrid>

@if (showEventPopup && selectedEvent != null)
{
    <div style="position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:9999; display:flex; align-items:center; justify-content:center;"
         @onclick="@(() => showEventPopup = false)">
        <MudCard Style="min-width:300px; max-width:460px; width:90%;" @onclick:stopPropagation="true">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">@selectedEvent.Label</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                   OnClick="@(() => showEventPopup = false)" />
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid Spacing="2">
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Inizio</MudText>
                        <MudText Typo="Typo.body2">@selectedEvent.Start.ToString("ddd dd/MM HH:mm")</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Fine</MudText>
                        <MudText Typo="Typo.body2">@selectedEvent.End.ToString("ddd dd/MM HH:mm")</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Durata</MudText>
                        <MudText Typo="Typo.body2">@($"{(int)(selectedEvent.End - selectedEvent.Start).TotalHours}h {(selectedEvent.End - selectedEvent.Start).Minutes:D2}m")</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption">Stato</MudText>
                        <MudChip T="string" Size="Size.Small" Style="@($"background:{selectedEvent.Color}; color:white; margin:0; height:22px;")">
                            @selectedEvent.StatusLabel
                        </MudChip>
                    </MudItem>
                    @if (!string.IsNullOrEmpty(selectedEvent.LicensePlate))
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption">Veicolo</MudText>
                            <MudText Typo="Typo.body2">@selectedEvent.LicensePlate</MudText>
                        </MudItem>
                    }
                    @if (!string.IsNullOrEmpty(selectedEvent.EmployeeNames))
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption">Operatore/i</MudText>
                            <MudText Typo="Typo.body2">@selectedEvent.EmployeeNames</MudText>
                        </MudItem>
                    }
                    @if (selectedEvent.EstimatedHours.HasValue)
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption">Ore stimate</MudText>
                            <MudText Typo="Typo.body2">@selectedEvent.EstimatedHours.Value.ToString("F1") h</MudText>
                        </MudItem>
                    }
                </MudGrid>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.History"
                           OnClick="@OpenSelectedEventDetailPage">
                    @EventDetailButtonLabel
                </MudButton>
                <MudSpacer />
                <MudButton Variant="Variant.Text" OnClick="@(() => showEventPopup = false)">Chiudi</MudButton>
            </MudCardActions>
        </MudCard>
    </div>
}

@code {
    private Employee? employee;
    private bool processing = true;

    // Tab 1 state
    private DateTime currentWeekStart = GetMonday(DateTime.Today);
    // Tab 2 state
    private DateTime currentWeekStartL = GetMonday(DateTime.Today);
    private string selectedEmployeeId = "";
    private CalEvent? selectedEvent;
    private bool showEventPopup;

    private string EventDetailButtonLabel =>
        selectedEvent?.IsCompleted == true ? "Vai allo storico" : "Vai a lavorazioni";

    private void OpenSelectedEventDetailPage()
    {
        if (selectedEvent == null) return;
        showEventPopup = false;
        navigationManager.NavigateTo(selectedEvent.IsCompleted ? "workflowshistory" : "workflows");
    }

    // Data
    private List<WorkflowExecution> allExecutions = new();
    private List<Veichle> veichles = new();
    private List<Workshopmanagement.DatabaseManagment.DataObject.Workflow> workflows = new();
    private List<Employee> employees = new();
    private List<TimeTracking> allTrackings = new();
    private CompanySettings settings = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                processing = true;
                var isUserLogged = await Utility.IsUserLoggedInAsync(protectedLocalStorage);
                if (!isUserLogged)
                {
                    snackbar.Add(@languageContainer.Keys["LoginExpiredError"], Severity.Warning);
                    navigationManager.NavigateTo("login");
                    return;
                }
                employee = await Utility.GetCurrentLoggedEmployee(protectedLocalStorage);
                if (employee?.EmployeeRole != EmployeeRole.Manager)
                {
                    snackbar.Add(@languageContainer.Keys["UserNotAutorized"], Severity.Warning);
                    navigationManager.NavigateTo("dashboard");
                    return;
                }
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            if (!ex.Message.Contains("was not found in the key ring"))
                snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            if (processing)
            {
                processing = false;
                if (firstRender) StateHasChanged();
            }
        }
    }

    private async Task LoadData()
    {
        var settingsList = await dbDependency.GetDataAccessCompanySettings().FindAsync(new SearcherCompanySettings());
        settings = settingsList.FirstOrDefault() ?? new CompanySettings();

        veichles = await dbDependency.GetDataAccessVeichle().FindAsync(new SearcherVeichle());
        workflows = await dbDependency.GetDataAccessWorkflow().FindAsync(new SearcherWorkflow());
        employees = await dbDependency.GetDataAccessEmployee().FindAsync(new SearcherEmployee());
        allTrackings = await dbDependency.GetDataAccessTimeTracking().FindAsync(new SearcherTimeTracking());

        var allSeriesIds = veichles
            .Where(v => v.OpenWorkflows != null)
            .SelectMany(v => v.OpenWorkflows!.Select(e => e.WorkflowExecutionSeriesId))
            .Where(id => !string.IsNullOrEmpty(id))
            .Distinct()
            .ToList();

        allExecutions = new List<WorkflowExecution>();
        foreach (var sid in allSeriesIds)
        {
            var execs = await dbDependency.GetDataAccessWorkflowExecution().FindAsync(
                new SearcherWorkflowExecution { WorkflowExecutionSeriesId = sid });
            allExecutions.AddRange(execs);
        }

        foreach (var v in veichles)
        {
            if (v.WorkflowExecutionsCompleted == null) continue;
            foreach (var completedSeriesId in v.WorkflowExecutionsCompleted)
            {
                if (string.IsNullOrEmpty(completedSeriesId)) continue;
                if (!allSeriesIds.Contains(completedSeriesId))
                {
                    allSeriesIds.Add(completedSeriesId);
                    var execs2 = await dbDependency.GetDataAccessWorkflowExecution().FindAsync(
                        new SearcherWorkflowExecution { WorkflowExecutionSeriesId = completedSeriesId });
                    allExecutions.AddRange(execs2);
                }
            }
        }
    }

    // ──────────────────────────────────────────────────
    // Calendar event model
    // ──────────────────────────────────────────────────

    private class CalEvent
    {
        public string SeriesId { get; set; } = "";
        public string EmployeeTag { get; set; } = "";
        public string Label { get; set; } = "";
        public string SubLabel { get; set; } = "";
        public string LicensePlate { get; set; } = "";
        public string EmployeeNames { get; set; } = "";
        public double? EstimatedHours { get; set; }
        public string StatusLabel { get; set; } = "";
        public DateTime Start { get; set; }
        public DateTime End { get; set; }
        public bool IsCompleted { get; set; }
        public bool IsInFuture { get; set; }
        public bool HasActiveTracking { get; set; }
        public string Color => IsCompleted
            ? "#1976d2"  // tracking session completed = blue
            : (IsInFuture ? "#bdbdbd" : (HasActiveTracking ? "#2e7d32" : "#1976d2"));
        public string TextColor => "#ffffff";
    }

    // ──────────────────────────────────────────────────
    // Tab 1 — Appuntamenti events (StartDate + EstimatedHours via working-hours algorithm)
    // ──────────────────────────────────────────────────

    private List<CalEvent> BuildAppuntamentiEvents()
    {
        var events = new List<CalEvent>();
        var ms = settings.MorningStart;
        var me = settings.MorningEnd;
        var as_ = settings.AfternoonStart;
        var ae = settings.AfternoonEnd;

        var bySeriesId = allExecutions
            .Where(e => e.StartDate.HasValue)
            .GroupBy(e => e.WorkflowExecutionSeriesId)
            .ToList();

        foreach (var group in bySeriesId)
        {
            var seriesId = group.Key;
            var execs = group.ToList();

            var startDate = execs.Min(e => e.StartDate)!.Value;
            var estimatedHours = execs.FirstOrDefault()?.EstimatedHours;
            var isCompleted = execs.All(e =>
                e.ExecutionStatus == WorkflowExecutionStatus.Closed ||
                e.ExecutionStatus == WorkflowExecutionStatus.Skipped);
            var closedAt = isCompleted ? execs.Max(e => e.ClosedAt) : null;

            DateTime logicalEnd;
            if (isCompleted && closedAt.HasValue)
                logicalEnd = closedAt.Value;
            else if (estimatedHours.HasValue && estimatedHours.Value > 0)
                logicalEnd = AddWorkingMinutes(startDate, estimatedHours.Value * 60, ms, me, as_, ae);
            else
                logicalEnd = AddWorkingMinutes(startDate, 60, ms, me, as_, ae);

            var hasActive = allTrackings.Any(t => t.WorkflowExecutionSeriesId == seriesId && t.IsActive);
            var isInFuture = startDate.Date > DateTime.Today;

            var wfExec = execs.FirstOrDefault();
            var wf = wfExec != null ? workflows.FirstOrDefault(w => w.Id == wfExec.WorkflowId) : null;
            var veichle = wfExec?.VeichleId != null ? veichles.FirstOrDefault(v => v.Id == wfExec.VeichleId) : null;
            var plate = veichle?.LicensePlate ?? "";
            var empIds1 = allTrackings.Where(t => t.WorkflowExecutionSeriesId == seriesId).Select(t => t.EmployeeId).Distinct().ToList();
            var empNames1 = string.Join(", ", employees.Where(e => empIds1.Contains(e.Id)).Select(e => $"{e.Name} {e.Surname}"));
            var statusLabel1 = isCompleted ? "Completato" : (hasActive ? "In Lavorazione" : (isInFuture ? "Programmato" : "Aperto"));

            events.Add(new CalEvent
            {
                SeriesId = seriesId,
                Label = wf?.Title ?? seriesId,
                SubLabel = plate,
                LicensePlate = plate,
                EmployeeNames = empNames1,
                EstimatedHours = estimatedHours,
                StatusLabel = statusLabel1,
                Start = startDate,
                End = logicalEnd,
                IsCompleted = isCompleted,
                IsInFuture = isInFuture,
                HasActiveTracking = hasActive
            });
        }

        return events;
    }

    // ──────────────────────────────────────────────────
    // Tab 2 — Lavorazioni events (actual tracking sessions)
    // ──────────────────────────────────────────────────

    private List<CalEvent> BuildLavorazioniEvents(string? employeeId)
    {
        var events = new List<CalEvent>();

        var trackingsToShow = string.IsNullOrEmpty(employeeId)
            ? allTrackings
            : allTrackings.Where(t => t.EmployeeId == employeeId).ToList();

        foreach (var tracking in trackingsToShow)
        {
            if (tracking.Sessions == null) continue;

            var wfExec = allExecutions.FirstOrDefault(e =>
                e.WorkflowExecutionSeriesId == tracking.WorkflowExecutionSeriesId);
            var wf = wfExec != null ? workflows.FirstOrDefault(w => w.Id == wfExec.WorkflowId) : null;
            var veichle = wfExec?.VeichleId != null ? veichles.FirstOrDefault(v => v.Id == wfExec.VeichleId) : null;

            // Find employee name for subtitle when showing all employees
            var emp = employees.FirstOrDefault(e => e.Id == tracking.EmployeeId);
            var empLabel = (emp != null && string.IsNullOrEmpty(employeeId))
                ? $"[{emp.Name} {emp.Surname}]"
                : "";

            foreach (var session in tracking.Sessions)
            {
                var start = session.StartTime;
                var end = session.EndTime ?? DateTime.Now;
                var isActive = !session.EndTime.HasValue;

                var plate2 = veichle?.LicensePlate ?? "";
                var empName2 = emp != null ? $"{emp.Name} {emp.Surname}" : "";
                var statusLabel2 = isActive ? "In Corso" : "Completato";

                events.Add(new CalEvent
                {
                    SeriesId = tracking.WorkflowExecutionSeriesId,
                    EmployeeTag = tracking.EmployeeId,
                    Label = wf?.Title ?? tracking.WorkflowExecutionSeriesId,
                    SubLabel = $"{plate2} {empLabel}".Trim(),
                    LicensePlate = plate2,
                    EmployeeNames = empName2,
                    StatusLabel = statusLabel2,
                    Start = start,
                    End = end,
                    IsCompleted = !isActive,
                    IsInFuture = false,
                    HasActiveTracking = isActive
                });
            }
        }

        // Compact nearby sessions per employee (gap ≤ 15 min → merge into one visual block)
        const int compactGapMin = 15;
        var compacted = new List<CalEvent>();
        foreach (var empGroup in events.GroupBy(e => e.EmployeeTag))
        {
            var sorted = empGroup.OrderBy(e => e.Start).ToList();
            var cur = sorted[0];
            for (int i = 1; i < sorted.Count; i++)
            {
                if ((sorted[i].Start - cur.End).TotalMinutes <= compactGapMin)
                {
                    if (sorted[i].End > cur.End) cur.End = sorted[i].End;
                    if (sorted[i].HasActiveTracking) cur.HasActiveTracking = true;
                    if (!sorted[i].IsCompleted) cur.IsCompleted = false;
                }
                else
                {
                    compacted.Add(cur);
                    cur = sorted[i];
                }
            }
            compacted.Add(cur);
        }
        return compacted;
    }

    // ──────────────────────────────────────────────────
    // Working-hours helpers (used only for event END calculation)
    // ──────────────────────────────────────────────────

    private static DateTime AddWorkingMinutes(DateTime from, double minutes,
        TimeOnly ms, TimeOnly me, TimeOnly as_, TimeOnly ae)
    {
        from = SnapToWorkingTime(from, ms, me, as_, ae);
        var remaining = minutes;
        var current = from;
        int safety = 0;
        while (remaining > 0 && safety++ < 10000)
        {
            var slotEnd = GetWorkSlotEnd(current, ms, me, as_, ae);
            if (slotEnd == null)
            {
                current = current.Date.AddDays(1).Add(ms.ToTimeSpan());
                continue;
            }
            var available = (slotEnd.Value - current).TotalMinutes;
            if (available >= remaining)
            {
                current = current.AddMinutes(remaining);
                remaining = 0;
            }
            else
            {
                remaining -= available;
                current = slotEnd.Value;
                current = SnapForwardFromSlotEnd(current, ms, me, as_, ae);
            }
        }
        return current;
    }

    private static DateTime SnapToWorkingTime(DateTime dt, TimeOnly ms, TimeOnly me, TimeOnly as_, TimeOnly ae)
    {
        var t = TimeOnly.FromDateTime(dt);
        if (t >= ms && t < me) return dt;
        if (t >= as_ && t < ae) return dt;
        if (t < ms) return dt.Date.Add(ms.ToTimeSpan());
        if (t >= me && t < as_) return dt.Date.Add(as_.ToTimeSpan());
        return dt.Date.AddDays(1).Add(ms.ToTimeSpan());
    }

    private static DateTime? GetWorkSlotEnd(DateTime current, TimeOnly ms, TimeOnly me, TimeOnly as_, TimeOnly ae)
    {
        var t = TimeOnly.FromDateTime(current);
        if (t >= ms && t < me) return current.Date.Add(me.ToTimeSpan());
        if (t >= as_ && t < ae) return current.Date.Add(ae.ToTimeSpan());
        return null;
    }

    private static DateTime SnapForwardFromSlotEnd(DateTime current, TimeOnly ms, TimeOnly me, TimeOnly as_, TimeOnly ae)
    {
        var t = TimeOnly.FromDateTime(current);
        if (t >= me && t <= as_) return current.Date.Add(as_.ToTimeSpan());
        return current.Date.AddDays(1).Add(ms.ToTimeSpan());
    }

    // Returns the portions of [evStart, evEnd] that fall within working hours on the given day
    private static List<(DateTime, DateTime)> GetWorkingSegmentsForDay(
        DateTime evStart, DateTime evEnd, DateTime day,
        TimeOnly ms, TimeOnly me, TimeOnly as_, TimeOnly ae)
    {
        var result = new List<(DateTime, DateTime)>();
        var d = day.Date;
        var s1 = d.Add(ms.ToTimeSpan());
        var e1 = d.Add(me.ToTimeSpan());
        if (s1 < evEnd && e1 > evStart)
            result.Add((s1 > evStart ? s1 : evStart, e1 < evEnd ? e1 : evEnd));
        var s2 = d.Add(as_.ToTimeSpan());
        var e2 = d.Add(ae.ToTimeSpan());
        if (s2 < evEnd && e2 > evStart)
            result.Add((s2 > evStart ? s2 : evStart, e2 < evEnd ? e2 : evEnd));
        return result;
    }

    // ──────────────────────────────────────────────────
    // Navigation helpers
    // ──────────────────────────────────────────────────

    private static DateTime GetMonday(DateTime date)
    {
        int dow = (int)date.DayOfWeek;
        return date.AddDays(dow == 0 ? -6 : -(dow - 1));
    }

    private void PrevWeek() { currentWeekStart = currentWeekStart.AddDays(-7); }
    private void NextWeek() { currentWeekStart = currentWeekStart.AddDays(7); }
    private void GoToToday() { currentWeekStart = GetMonday(DateTime.Today); }

    private void PrevWeekL() { currentWeekStartL = currentWeekStartL.AddDays(-7); }
    private void NextWeekL() { currentWeekStartL = currentWeekStartL.AddDays(7); }
    private void GoToTodayL() { currentWeekStartL = GetMonday(DateTime.Today); }

    private string GetWeekLabel()
    {
        var end = currentWeekStart.AddDays(6);
        return $"{currentWeekStart:dd MMM} – {end:dd MMM yyyy}";
    }
    private string GetWeekLabelL()
    {
        var end = currentWeekStartL.AddDays(6);
        return $"{currentWeekStartL:dd MMM} – {end:dd MMM yyyy}";
    }

    // ──────────────────────────────────────────────────
    // Shared 24h week-calendar renderer (Google Calendar style)
    // ──────────────────────────────────────────────────

    private RenderFragment RenderWeekCalendar(List<CalEvent> events, DateTime weekStart, bool workingHoursOnly = false, bool splitNonWorking = false) => builder =>
    {
        var ms  = settings.MorningStart;
        var me  = settings.MorningEnd;
        var as_ = settings.AfternoonStart;
        var ae  = settings.AfternoonEnd;

        var days = Enumerable.Range(0, 7).Select(i => weekStart.AddDays(i)).ToList();
        const double slotH   = 28;    // px per 30-min slot
        const double timeW   = 52;    // time column width
        const double hdrH    = 36;    // header height
        const double dayMinW = 120;   // min day column width
        const int    totalSlots = 48;
        int firstSlot = workingHoursOnly ? (ms.Hour * 60 + ms.Minute) / 30 : 0;
        int lastSlot  = workingHoursOnly ? (ae.Hour * 60 + ae.Minute) / 30 : totalSlots;
        int slotCount = lastSlot - firstSlot;
        double totalH = slotCount * slotH;
        var ic = System.Globalization.CultureInfo.InvariantCulture;
        DateTime now = DateTime.Now;
        int seq = 0;

        // ── outer scroll container ──────────────────────────────────────
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "style",
            "overflow:auto; max-height:70vh; border:1px solid #333; border-radius:4px;");

        // ── inner flex row ──────────────────────────────────────────────
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "style",
            $"display:flex; min-width:{timeW + dayMinW * 7}px;");

        // ═══ TIME COLUMN ═══════════════════════════════════════════════
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "style",
            $"width:{timeW}px; flex-shrink:0; position:sticky; left:0; z-index:3; background:#1e1e2e;");

        // blank header cell aligned with day headers
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "style",
            $"height:{hdrH}px; position:sticky; top:0; z-index:4; background:#1e1e2e; border-bottom:1px solid #444;");
        builder.CloseElement();

        for (int si = firstSlot; si < lastSlot; si++)
        {
            int startMin = si * 30;
            var t = TimeOnly.FromTimeSpan(TimeSpan.FromMinutes(startMin));
            bool isWork = (t >= ms && t < me) || (t >= as_ && t < ae);
            bool onHour = startMin % 60 == 0;
            string bdr = onHour ? "border-top:1px solid #383838;" : "border-top:1px solid #282828;";
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "style",
                $"height:{slotH}px; {bdr} padding:2px 4px 0; font-size:0.68rem;" +
                $" color:{(isWork ? "#ccc" : "#555")}; white-space:nowrap;");
            if (onHour) builder.AddContent(seq++, t.ToString("HH:mm"));
            builder.CloseElement();
        }
        builder.CloseElement(); // time column

        // ═══ DAYS WRAPPER ═══════════════════════════════════════════════
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "style", "flex:1; overflow-x:hidden; position:relative;");

        // sticky day headers
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "style",
            $"display:flex; position:sticky; top:0; z-index:2; height:{hdrH}px;");
        foreach (var day in days)
        {
            bool isToday = day.Date == DateTime.Today;
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "style",
                $"flex:1; min-width:{dayMinW}px;" +
                $" background:{(isToday ? "#1565c0" : "#2a2a3a")}; border-left:1px solid #333;" +
                " display:flex; align-items:center; justify-content:center;" +
                " color:white; font-size:0.78rem; font-weight:500;");
            builder.AddContent(seq++, day.ToString("ddd dd/MM"));
            builder.CloseElement();
        }
        builder.CloseElement(); // day headers

        // days body (event columns)
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "style", $"display:flex; height:{totalH}px;");

        foreach (var day in days)
        {
            bool isToday = day.Date == DateTime.Today;
            DateTime dayStart = workingHoursOnly ? day.Date.Add(ms.ToTimeSpan()) : day.Date;
            DateTime dayEnd   = workingHoursOnly ? day.Date.Add(ae.ToTimeSpan()) : day.Date.AddDays(1);

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "style",
                $"flex:1; min-width:{dayMinW}px; position:relative; height:{totalH}px; overflow:hidden;" +
                $" border-left:1px solid #333;" +
                $" background:{(isToday ? "rgba(25,118,210,0.04)" : "transparent")};");

            // grid lines
            for (int si = firstSlot; si < lastSlot; si++)
            {
                int startMin = si * 30;
                var t = TimeOnly.FromTimeSpan(TimeSpan.FromMinutes(startMin));
                bool isWork = (t >= ms && t < me) || (t >= as_ && t < ae);
                bool onHour = startMin % 60 == 0;
                string bdr = onHour ? "border-top:1px solid #383838;" : "border-top:1px solid #282828;";
                string bg  = isWork ? "rgba(255,255,255,0.025)" : "transparent";
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "style",
                    $"position:absolute; top:{((si - firstSlot) * slotH).ToString("F0", ic)}px;" +
                    $" left:0; right:0; height:{slotH}px; {bdr} background:{bg}; pointer-events:none;");
                builder.CloseElement();
            }

            // current-time line
            if (isToday)
            {
                double nowMin = now.Hour * 60.0 + now.Minute;
                double nowTop = (nowMin / 30.0 - firstSlot) * slotH;
                if (nowTop >= 0 && nowTop <= totalH)
                {
                    builder.OpenElement(seq++, "div");
                    builder.AddAttribute(seq++, "style",
                        $"position:absolute; top:{nowTop.ToString("F1", ic)}px;" +
                        " left:0; right:0; height:2px; background:#ff5722; z-index:2; pointer-events:none;");
                    builder.CloseElement();
                }
            }

            // ── event layout: greedy column assignment ──────────────
            var dayEvents = events
                .Where(e => e.Start < dayEnd && e.End > dayStart)
                .OrderBy(e => e.Start)
                .ThenByDescending(e => e.End)
                .ToList();

            // Expand events into render entries: either one per event, or one per working segment
            var renderEntries = new List<(CalEvent ev, DateTime segStart, DateTime segEnd)>();
            if (splitNonWorking)
            {
                foreach (var ev in dayEvents)
                {
                    var segs = GetWorkingSegmentsForDay(ev.Start, ev.End, day, ms, me, as_, ae);
                    foreach (var (ss, se) in segs)
                        renderEntries.Add((ev, ss, se));
                }
            }
            else
            {
                foreach (var ev in dayEvents)
                {
                    var cs = ev.Start < dayStart ? dayStart : ev.Start;
                    var ce = ev.End > dayEnd ? dayEnd : ev.End;
                    if (ce > cs) renderEntries.Add((ev, cs, ce));
                }
            }

            var colOfEntry = new int[renderEntries.Count];
            var colEnds    = new List<DateTime>();

            for (int i = 0; i < renderEntries.Count; i++)
            {
                var (_, eStart, eEnd) = renderEntries[i];
                int col = 0;
                while (col < colEnds.Count && colEnds[col] > eStart) col++;
                colOfEntry[i] = col;
                if (col == colEnds.Count) colEnds.Add(eEnd);
                else colEnds[col] = eEnd;
            }

            for (int i = 0; i < renderEntries.Count; i++)
            {
                var (ev, evStart, evEnd) = renderEntries[i];
                if (evEnd <= evStart) continue;

                double topPx = (evStart - dayStart).TotalMinutes / 30.0 * slotH;
                double hPx   = Math.Max((evEnd - evStart).TotalMinutes / 30.0 * slotH, 14.0);

                // count total columns active in this entry's time window
                int totalCols = 1;
                for (int j = 0; j < renderEntries.Count; j++)
                {
                    var (_, sj, ej) = renderEntries[j];
                    if (sj < evEnd && ej > evStart)
                        totalCols = Math.Max(totalCols, colOfEntry[j] + 1);
                }

                double leftPct = 100.0 * colOfEntry[i] / totalCols;
                double wPct    = 100.0 / totalCols;
                double opacity = (ev.IsCompleted || ev.IsInFuture) && !ev.HasActiveTracking ? 0.6 : 1.0;

                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "style",
                    $"position:absolute;" +
                    $" top:{topPx.ToString("F1", ic)}px;" +
                    $" height:{hPx.ToString("F1", ic)}px;" +
                    $" left:calc({leftPct.ToString("F1", ic)}% + 1px);" +
                    $" width:calc({wPct.ToString("F1", ic)}% - 2px);" +
                    $" background:{ev.Color}; color:{ev.TextColor};" +
                    " border-radius:3px; z-index:1; padding:2px 4px; box-sizing:border-box;" +
                    $" font-size:0.65rem; overflow:hidden; line-height:1.3;" +
                    $" opacity:{opacity.ToString("F2", ic)}; cursor:pointer;");
                builder.AddAttribute(seq++, "onclick",
                    EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(
                        this, () => { selectedEvent = ev; showEventPopup = true; InvokeAsync(StateHasChanged); }));

                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "style", "white-space:nowrap; overflow:hidden; text-overflow:ellipsis;");
                builder.AddContent(seq++, ev.Label);
                builder.CloseElement();

                if (!string.IsNullOrEmpty(ev.SubLabel) && hPx >= 28)
                {
                    builder.OpenElement(seq++, "div");
                    builder.AddAttribute(seq++, "style",
                        "white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:0.6rem; opacity:0.85;");
                    builder.AddContent(seq++, ev.SubLabel);
                    builder.CloseElement();
                }

                builder.CloseElement(); // event div
            }

            builder.CloseElement(); // day column
        }

        builder.CloseElement(); // days body
        builder.CloseElement(); // days wrapper
        builder.CloseElement(); // inner flex row
        builder.CloseElement(); // outer scroll container
    };
}
