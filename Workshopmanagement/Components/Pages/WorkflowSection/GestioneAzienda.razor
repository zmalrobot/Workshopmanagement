@page "/gestioneazienda"

@inject IJSRuntime JSRuntime
@inject IDbDependency dbDependency
@inject ISnackbar snackbar
@inject ILanguageContainerService languageContainer
@inject ProtectedLocalStorage protectedLocalStorage
@inject NavigationManager navigationManager
@inject IWebHostEnvironment webHostEnvironment
@inject ThemeService themeService
@inject LogSettingsService logSettingsService
@inject IAppLogger appLogger

<MudContainer Class="loading-overlay" Style="@(processing ? "display:flex;" : "display:none;")">
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
</MudContainer>

<MudGrid>
    <MudItem xs="12">
        <MudText Typo="Typo.h5">@languageContainer.Keys["GestioneAzienda"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@languageContainer.Keys["GestioneAziendaDesc"]</MudText>
    </MudItem>

    @if (!processing)
    {
        <!-- Company Info Card -->
        <MudItem xs="12" md="6">
            <MudCard Elevation="3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.Business" Class="mr-2" />
                            @languageContainer.Keys["CompanyInfo"]
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="settings.CompanyName"
                                          Label="@languageContainer.Keys["CompanyName"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="settings.CompanyVatNumber"
                                          Label="@languageContainer.Keys["CompanyVatNumber"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="settings.CompanyPhone"
                                          Label="@languageContainer.Keys["CompanyPhone"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          FullWidth="true" />
                        </MudItem>
                        <MudItem xs="9">
                            <MudTextField @bind-Value="settings.AddressStreet"
                                          Label="@languageContainer.Keys["AddressStreet"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          FullWidth="true" />
                        </MudItem>
                        <MudItem xs="3">
                            <MudTextField @bind-Value="settings.AddressNumber"
                                          Label="@languageContainer.Keys["AddressNumber"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="settings.AddressInterior"
                                          Label="@languageContainer.Keys["AddressInterior"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          FullWidth="true" />
                        </MudItem>
                        <MudItem xs="3">
                            <MudTextField @bind-Value="settings.AddressCAP"
                                          Label="@languageContainer.Keys["AddressCAP"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          FullWidth="true" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="settings.AddressCity"
                                          Label="@languageContainer.Keys["AddressCity"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          FullWidth="true" />
                        </MudItem>
                        <MudItem xs="3">
                            <MudTextField @bind-Value="settings.AddressProvince"
                                          Label="@languageContainer.Keys["AddressProvince"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudText Typo="Typo.body2" Class="mb-2">@languageContainer.Keys["CompanyLogo"]</MudText>
                            @if (logoPreviewBase64 != null)
                            {
                                <div style="margin-bottom:8px;">
                                    <img src="@logoPreviewBase64" alt="Preview" style="width:128px; height:128px; object-fit:cover; border-radius:50%; border:2px solid #555; background:#222;" />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@languageContainer.Keys["CompanyLogoPreview"]</MudText>
                                </div>
                            }
                            else if (settings.HasLogo)
                            {
                                <div style="margin-bottom:8px;">
                                    <img src="@logoUrl" alt="Logo" style="width:128px; height:128px; object-fit:cover; border-radius:50%; border:2px solid #555; background:#222;" />
                                </div>
                            }
                            <MudFileUpload T="IBrowserFile" Accept="image/*" FilesChanged="OnLogoChanged">
                                <ActivatorContent>
                                    <MudButton Variant="Variant.Outlined"
                                               StartIcon="@Icons.Material.Filled.CloudUpload"
                                               Color="Color.Info"
                                               Size="Size.Small">
                                        @languageContainer.Keys["CompanyLogoUpload"]
                                    </MudButton>
                                </ActivatorContent>
                            </MudFileUpload>
                            @if (logoFile != null)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Success">@logoFile.Name</MudText>
                            }
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Working Hours Card -->
        <MudItem xs="12" md="6">
            <MudCard Elevation="3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="mr-2" />
                            @languageContainer.Keys["WorkingHoursConfig"]
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2">@languageContainer.Keys["WorkingHoursMorning"]</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudTimePicker Label="@languageContainer.Keys["WorkingHoursStart"]"
                                           Time="@morningStart"
                                           TimeChanged="@(t => morningStart = t)"
                                           AmPm="false"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTimePicker Label="@languageContainer.Keys["WorkingHoursEnd"]"
                                           Time="@morningEnd"
                                           TimeChanged="@(t => morningEnd = t)"
                                           AmPm="false"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2">@languageContainer.Keys["WorkingHoursAfternoon"]</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudTimePicker Label="@languageContainer.Keys["WorkingHoursStart"]"
                                           Time="@afternoonStart"
                                           TimeChanged="@(t => afternoonStart = t)"
                                           AmPm="false"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTimePicker Label="@languageContainer.Keys["WorkingHoursEnd"]"
                                           Time="@afternoonEnd"
                                           TimeChanged="@(t => afternoonEnd = t)"
                                           AmPm="false"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense" />
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* ─── Appearance card ─────────────────────────────────────────────── *@
        <MudItem xs="12">
            <MudCard Elevation="3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.Palette" Class="mr-2" />
                            @languageContainer.Keys["AppearanceSettings"]
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@languageContainer.Keys["AppearanceSettingsDesc"]</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudGrid Spacing="3">

                        @* ── Dark column ──────────────────────────────── *@
                        <MudItem xs="12" sm="6">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.DarkMode" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary"
                                         Style="text-transform:uppercase; letter-spacing:0.07em; font-weight:600;">@languageContainer.Keys["ThemeDarkMode"]</MudText>
                            </MudStack>
                            <MudStack Spacing="2">
                                @foreach (var info in GetThemeOptions().Where(t => t.IsDark))
                                {
                                    var isSelected = themeService.CurrentVariant == info.Variant;
                                    <MudCard Outlined="@(!isSelected)" Elevation="@(isSelected ? 4 : 1)"
                                             Style="@($"cursor:pointer; border:2px solid {(isSelected ? info.PrimaryColor : "transparent")}; border-radius:12px; transition:all 0.2s ease;")"
                                             @onclick="() => ApplyTheme(info.Variant)">
                                        <MudCardContent Class="pa-3">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                @* Palette swatch *@
                                                <div style="@($"width:44px; height:44px; border-radius:8px; background:{info.BackgroundColor}; border:1px solid rgba(128,128,128,0.25); flex-shrink:0; position:relative; overflow:hidden;")"
                                                     title="@info.Name">
                                                    <div style="@($"position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:22px; height:22px; border-radius:50%; background:{info.PrimaryColor};")" />
                                                    <div style="@($"position:absolute; bottom:5px; right:5px; width:9px; height:9px; border-radius:50%; background:{info.AccentColor};")" />
                                                </div>
                                                @* Labels *@
                                                <MudStack Spacing="0" Style="flex:1; min-width:0;">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary"
                                                             Style="font-size:0.68rem; text-transform:uppercase; letter-spacing:0.06em;">@info.DesignSystem</MudText>
                                                    <MudText Typo="Typo.subtitle2" Style="font-weight:600;">@info.Name</MudText>
                                                </MudStack>
                                                @if (isSelected)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Style="flex-shrink:0;" />
                                                }
                                            </MudStack>
                                        </MudCardContent>
                                    </MudCard>
                                }
                            </MudStack>
                        </MudItem>

                        @* ── Light column ─────────────────────────────── *@
                        <MudItem xs="12" sm="6">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.LightMode" Size="Size.Small" Color="Color.Secondary" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary"
                                         Style="text-transform:uppercase; letter-spacing:0.07em; font-weight:600;">@languageContainer.Keys["ThemeLightMode"]</MudText>
                            </MudStack>
                            <MudStack Spacing="2">
                                @foreach (var info in GetThemeOptions().Where(t => !t.IsDark))
                                {
                                    var isSelected = themeService.CurrentVariant == info.Variant;
                                    <MudCard Outlined="@(!isSelected)" Elevation="@(isSelected ? 4 : 1)"
                                             Style="@($"cursor:pointer; border:2px solid {(isSelected ? info.PrimaryColor : "transparent")}; border-radius:12px; transition:all 0.2s ease;")"
                                             @onclick="() => ApplyTheme(info.Variant)">
                                        <MudCardContent Class="pa-3">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                                @* Palette swatch *@
                                                <div style="@($"width:44px; height:44px; border-radius:8px; background:{info.BackgroundColor}; border:1px solid rgba(128,128,128,0.25); flex-shrink:0; position:relative; overflow:hidden;")"
                                                     title="@info.Name">
                                                    <div style="@($"position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:22px; height:22px; border-radius:50%; background:{info.PrimaryColor};")" />
                                                    <div style="@($"position:absolute; bottom:5px; right:5px; width:9px; height:9px; border-radius:50%; background:{info.AccentColor};")" />
                                                </div>
                                                @* Labels *@
                                                <MudStack Spacing="0" Style="flex:1; min-width:0;">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary"
                                                             Style="font-size:0.68rem; text-transform:uppercase; letter-spacing:0.06em;">@info.DesignSystem</MudText>
                                                    <MudText Typo="Typo.subtitle2" Style="font-weight:600;">@info.Name</MudText>
                                                </MudStack>
                                                @if (isSelected)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Style="flex-shrink:0;" />
                                                }
                                            </MudStack>
                                        </MudCardContent>
                                    </MudCard>
                                }
                            </MudStack>
                        </MudItem>

                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveSettings">
                @languageContainer.Keys["Save"]
            </MudButton>
        </MudItem>

        @* ─── Log Level card ─────────────────────────────────────────────── *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.BugReport" Class="mr-2" />
                            @languageContainer.Keys["LogLevelSetting"]
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@languageContainer.Keys["LogLevelSettingDesc"]</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudSelect T="string"
                               @bind-Value="settings.LogLevel"
                               Label="@languageContainer.Keys["LogLevel"]"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               FullWidth="true">
                        <MudSelectItem Value="@("Debug")">@languageContainer.Keys["LogLevelDebug"]</MudSelectItem>
                        <MudSelectItem Value="@("Information")">@languageContainer.Keys["LogLevelInformation"]</MudSelectItem>
                        <MudSelectItem Value="@("Warning")">@languageContainer.Keys["LogLevelWarning"]</MudSelectItem>
                        <MudSelectItem Value="@("Error")">@languageContainer.Keys["LogLevelError"]</MudSelectItem>
                    </MudSelect>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    private Employee? employee;
    private bool processing = true;
    private CompanySettings settings = new();
    private IBrowserFile? logoFile;
    private byte[]? logoFileBytes;
    private string? logoPreviewBase64;
    private string logoUrl = "/images/companylogo.png";

    // MudTimePicker binds to TimeSpan?
    private TimeSpan? morningStart;
    private TimeSpan? morningEnd;
    private TimeSpan? afternoonStart;
    private TimeSpan? afternoonEnd;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                processing = true;
                var isUserLogged = await Utility.IsUserLoggedInAsync(protectedLocalStorage);
                if (!isUserLogged)
                {
                    snackbar.Add(@languageContainer.Keys["LoginExpiredError"], Severity.Warning);
                    navigationManager.NavigateTo("login");
                    return;
                }
                employee = await Utility.GetCurrentLoggedEmployee(protectedLocalStorage);
                if (employee?.EmployeeRole != EmployeeRole.Manager)
                {
                    snackbar.Add(@languageContainer.Keys["UserNotAutorized"], Severity.Warning);
                    navigationManager.NavigateTo("dashboard");
                    return;
                }
                await LoadSettings();
            }
        }
        catch (Exception ex)
        {
            if (!ex.Message.Contains("was not found in the key ring"))
                snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            if (processing)
            {
                processing = false;
                if (firstRender) StateHasChanged();
            }
        }
    }

    private async Task LoadSettings()
    {
        var list = await dbDependency.GetDataAccessCompanySettings().FindAsync(new SearcherCompanySettings());
        settings = list.FirstOrDefault() ?? new CompanySettings();

        // Sync ThemeService with stored preference
        if (!string.IsNullOrEmpty(settings.SelectedTheme) && Enum.TryParse<ThemeVariant>(settings.SelectedTheme, out var savedVariant))
            themeService.SetTheme(savedVariant);

        morningStart = settings.MorningStart.ToTimeSpan();
        morningEnd = settings.MorningEnd.ToTimeSpan();
        afternoonStart = settings.AfternoonStart.ToTimeSpan();
        afternoonEnd = settings.AfternoonEnd.ToTimeSpan();

        if (settings.HasLogo)
            logoUrl = $"/images/companylogo.png?v={DateTime.Now.Ticks}";
    }

    private async Task OnLogoChanged(IBrowserFile? file)
    {
        logoFile = file;
        logoPreviewBase64 = null;
        logoFileBytes = null;
        if (file != null)
        {
            using var ms = new MemoryStream();
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            await stream.CopyToAsync(ms);
            logoFileBytes = ms.ToArray();
            logoPreviewBase64 = $"data:{file.ContentType};base64,{Convert.ToBase64String(logoFileBytes)}";
            StateHasChanged();
        }
    }

    private async Task SaveSettings()
    {
        processing = true;
        try
        {
            // Apply time pickers back to settings
            if (morningStart.HasValue)
                settings.MorningStart = TimeOnly.FromTimeSpan(morningStart.Value);
            if (morningEnd.HasValue)
                settings.MorningEnd = TimeOnly.FromTimeSpan(morningEnd.Value);
            if (afternoonStart.HasValue)
                settings.AfternoonStart = TimeOnly.FromTimeSpan(afternoonStart.Value);
            if (afternoonEnd.HasValue)
                settings.AfternoonEnd = TimeOnly.FromTimeSpan(afternoonEnd.Value);

            // Handle logo upload
            if (logoFileBytes != null)
            {
                var imagesDir = Path.Combine(webHostEnvironment.WebRootPath, "images");
                Directory.CreateDirectory(imagesDir);

                // Remove old logo files
                foreach (var old in Directory.GetFiles(imagesDir, "companylogo.*"))
                    File.Delete(old);

                // Resize to 512x512 PNG using ImageSharp
                var logoPath = Path.Combine(imagesDir, "companylogo.png");
                await Utility.ResizeAndSaveLogoPngAsync(logoFileBytes, logoPath);

                settings.HasLogo = true;
                logoUrl = $"/images/companylogo.png?v={DateTime.Now.Ticks}";
                logoPreviewBase64 = null;
                logoFileBytes = null;
                logoFile = null;
                snackbar.Add(@languageContainer.Keys["CompanyLogoUploaded"], Severity.Info);
                await appLogger.LogInformationAsync("Logo aziendale caricato", new LogContext { EmployeeId = employee?.Id });
            }

            await dbDependency.GetDataAccessCompanySettings().UpsertAsync(settings, new SearcherCompanySettings { Id = settings.Id });

            // Update in-memory log level immediately
            logSettingsService.SetLogLevel(settings.LogLevel);

            snackbar.Add(@languageContainer.Keys["CompanySettingsSaved"], Severity.Success);
            await appLogger.LogInformationAsync("Impostazioni aziendali salvate", new LogContext { EmployeeId = employee?.Id, AdditionalInfo = $"LogLevel: {settings.LogLevel}" });
        }
        catch (Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
            await appLogger.LogErrorAsync("Errore salvataggio impostazioni aziendali", new LogContext { EmployeeId = employee?.Id }, ex);
        }
        finally
        {
            processing = false;
            StateHasChanged();
        }
    }

    // ── Theme picker helpers ───────────────────────────────────────────────

    private record ThemeInfo(
        ThemeVariant Variant,
        string Name,
        string DesignSystem,
        bool IsDark,
        string PrimaryColor,
        string BackgroundColor,
        string AccentColor);

    private List<ThemeInfo> GetThemeOptions() => new()
    {
        new(ThemeVariant.ChromaDark,         "Chroma",        "Chroma",         true,  "#CE8FFF", "#0D0823", "#FFB347"),
        new(ThemeVariant.ChromaLight,        "Chroma",        "Chroma",         false, "#7209B7", "#FFFBF5", "#C75000"),
        new(ThemeVariant.FrostedGlassDark,   "Frosted Glass", "Frosted Glass",  true,  "#0A84FF", "#000000", "#FF375F"),
        new(ThemeVariant.FrostedGlassLight,  "Frosted Glass", "Frosted Glass",  false, "#007AFF", "#F2F2F7", "#FF2D55"),
        new(ThemeVariant.AcrylicDark,        "Acrylic",       "Acrylic",        true,  "#4CC2FF", "#1C1C1C", "#9C7EF0"),
        new(ThemeVariant.AcrylicLight,       "Acrylic",       "Acrylic",        false, "#0067C0", "#F3F3F3", "#5B5FC7"),
        new(ThemeVariant.ForgeDark,          "Forge",         "Forge",          true,  "#78A9FF", "#161616", "#BE95FF"),
        new(ThemeVariant.ForgeLight,         "Forge",         "Forge",          false, "#0F62FE", "#F4F4F4", "#6929C4"),
        new(ThemeVariant.RetroWebDark,            "Y2K Dark",      "Retro Web 2000",     true,  "#00FF41", "#000000", "#00FFFF"),
        new(ThemeVariant.RetroWebLight,           "Y2K Light",     "Retro Web 2000",     false, "#003399", "#ECE9D8", "#006600"),
    };

    private void ApplyTheme(ThemeVariant variant)
    {
        settings.SelectedTheme = variant.ToString();
        themeService.SetTheme(variant);
        StateHasChanged();
    }
}

