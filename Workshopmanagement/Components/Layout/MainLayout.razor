@inherits LayoutComponentBase

@inject IJSRuntime JSRuntime
@inject ISnackbar snackbar
@inject ILanguageContainerService languageContainer
@inject ICamperTheme camperTheme
@inject ProtectedLocalStorage protectedLocalStorage
@inject NavigationManager navigationManager

@* Required *@
<MudThemeProvider Theme="@camperTheme.GetTheme()" IsDarkMode="true" />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

 <MudLayout>
    @if (!IsLoginPage)
    {
        <MudAppBar Elevation="1">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
            @if (Convert.ToBoolean(Environment.GetEnvironmentVariable("IsBeta")))
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Style="width: 100%;">
                    @languageContainer.Keys["BetaWarning"]
                </MudAlert>
            }            
            <MudSpacer />
            <MudIconButton OnClick="Logout" Icon="@Icons.Material.Filled.DesktopAccessDisabled" Color="Color.Inherit"/>
        </MudAppBar>

        <MudDrawer @bind-Open="@_open" Elevation="1">
            <MudNavMenu>
              <NavMenu/>
            </MudNavMenu>
        </MudDrawer>
    }
    
    <MudMainContent>
        <MudContainer Style="margin-top: 15px">
            @Body
        </MudContainer>      
    </MudMainContent>
</MudLayout>

@code {

    // You can modify the condition if other pages need to be excluded
    // e.g., to hide on "/login" and "/register", use:
    // private bool IsLoginPage => Navigation.Uri.Contains("login") || Navigation.Uri.Contains("register");
    private bool IsLoginPage => navigationManager.Uri.Contains("login");   

    private bool _open = true;
    private void ToggleDrawer()
    {
        _open = !_open;
    }

    private async Task Logout()
    {
        try
        {
            await Utility.SaveCurrentLoggedEmployee(protectedLocalStorage, null);

            snackbar.Add(@languageContainer.Keys["Logout"], Severity.Warning);
            navigationManager.NavigateTo($"login");
        }catch(Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
            navigationManager.NavigateTo($"login");
        }
       
    }
}
