@inherits LayoutComponentBase
@implements IDisposable

@inject IJSRuntime JSRuntime
@inject ISnackbar snackbar
@inject ILanguageContainerService languageContainer
@inject ICamperTheme camperTheme
@inject ThemeService themeService
@inject IDbDependency dbDependency
@inject ProtectedLocalStorage protectedLocalStorage
@inject NavigationManager navigationManager

@* Theme + dialog/snackbar providers *@
<MudThemeProvider Theme="@themeService.GetMudTheme()" IsDarkMode="@themeService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="app-wrapper @themeService.GetBodyClass()">
    <MudLayout>
        @if (!IsLoginPage)
        {
            <MudAppBar Elevation="0" Class="app-appbar">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
                @if (Convert.ToBoolean(Environment.GetEnvironmentVariable("IsBeta")))
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Text" Style="width: 100%;">
                        @languageContainer.Keys["BetaWarning"]
                    </MudAlert>
                }
                <MudSpacer />
                <MudIconButton OnClick="Logout" Icon="@Icons.Material.Filled.DesktopAccessDisabled" Color="Color.Inherit" />
            </MudAppBar>

            <MudDrawer @bind-Open="@_open" Elevation="0" Class="app-drawer">
                <MudNavMenu>
                    <NavMenu />
                </MudNavMenu>
            </MudDrawer>
        }

        <MudMainContent Class="app-main-content">
            <MudContainer Style="margin-top: 15px; padding-bottom: 24px;">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
</div>

@code {
    private bool IsLoginPage => navigationManager.Uri.Contains("login");
    private bool _open = true;

    private void ToggleDrawer() => _open = !_open;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !themeService.IsInitialized)
        {
            try
            {
                var list = await dbDependency.GetDataAccessCompanySettings().FindAsync(new SearcherCompanySettings());
                var saved = list.FirstOrDefault()?.SelectedTheme;
                if (!string.IsNullOrEmpty(saved) && Enum.TryParse<ThemeVariant>(saved, out var variant))
                    themeService.InitializeFromDb(variant);
                else
                    themeService.InitializeFromDb(ThemeVariant.MaterialExpressiveDark);
                StateHasChanged();
            }
            catch { /* keep default theme */ }
        }
    }

    protected override void OnInitialized()
    {
        themeService.OnThemeChanged += HandleThemeChanged;
    }

    private void HandleThemeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        themeService.OnThemeChanged -= HandleThemeChanged;
    }

    private async Task Logout()
    {
        try
        {
            await Utility.SaveCurrentLoggedEmployee(protectedLocalStorage, null);
            snackbar.Add(@languageContainer.Keys["Logout"], Severity.Warning);
            navigationManager.NavigateTo($"login");
        }
        catch (Exception ex)
        {
            snackbar.Add(ex.Message, Severity.Error);
            navigationManager.NavigateTo($"login");
        }
    }
}

